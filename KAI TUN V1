                    local p=sample.p+Vector3.new(math.cos(a)*range*fraction,0,math.sin(a)*range*fraction)
                    local key=math.floor(p.X/1.5)..":"..math.floor(p.Z/1.5)
                    if not seen[key] and (S.badPoints[key] or 0)<os.clock() then
                        seen[key]=true candidates+=1
                        local cacheKey=(d.hybrid_placement and "hybrid" or surface.Name)..":"..key
                        local hit=groundCache[cacheKey]
                        if hit==nil then
                            hit=workspace:Raycast(p+Vector3.new(0,60,0),Vector3.new(0,-120,0),ray) or false
                            if groundEntries<(S.mobileMode and 1600 or 3200) then
                                groundCache[cacheKey]=hit groundEntries+=1
                            else
                                -- Retain useful cached geometry; an overflowing new query is not a reason to discard it all.
                                perf.uncachedGroundQueries=(perf.uncachedGroundQueries or 0)+1
                            end
                        end
                        if hit and hit.Normal.Y>0.7 then
                            p=hit.Position local free=true
                            if not S.stackEnabled then
                                for _,o in occupied do
                                    if flat(p,o.p)<S.placementSpacing(d,defs[val(o.stats,"id")] or {}) then free=false break end
                                end
                            end
                            local roadDistance=math.huge local coverage=0 local first=math.huge
                            if free then coverage,first,roadDistance=pathCoverage(p,range,path,leak and leak.progress or 0,leak and path.length or limit) end
                            local progress=project(p,path)
                            local within=(not leak and progress<=limit) or (leak and progress>=low and progress<=high)
                            if incoming and not leak then
                                within=within and flat(p,incoming.p)>range+1 and first>incoming.progress+math.max(2,incoming.speed*2)
                            end
                            -- Early exposure is strongly weighted while retaining corner coverage.
                            local weight=leak and 1 or (1-0.7*math.min(first/limit,1))
                            local score=coverage*weight
                            if free and within and roadDistance>=2.5 and coverage>0 and (not winner or score>winner.score) then
                                winner={position=p,coverage=coverage,score=score,first=first,progress=progress,
                                    key=key,path=path,mode=leak and "REAR INTERCEPT" or incoming and "FRONT COUNTER" or "FRONT",unit=unit}
                            end
                        end
                        if os.clock()-sliceStart>0.002 then
                            perf.plannerYields=(perf.plannerYields or 0)+1
                            task.wait() sliceStart=os.clock() assert(S.alive,"Planner closed")
                        end
                    end
                end end
            end end
        end
    end
    if S.stackEnabled then
        local anchorWinner
        for _,o in occupied do
            for _,path in pathList do
                if (not leak or leak.path==path) and (not incoming or incoming.path==path) then
                    local progress,dist=project(o.p,path)
                    local zoneLow,zoneHigh=S.interceptionZone(path.length,leak and leak.progress or 0,range)
                    local valid=(leak and progress>=zoneLow and progress<=zoneHigh)
                        or (not leak and progress<=(spawnFront and path.length*0.30 or frontEnd(path,range)))
                    if valid and dist<=range then
                        local hit=workspace:Raycast(o.p+Vector3.new(0,20,0),Vector3.new(0,-100,0),ray)
                        if hit then
                            local coverage=0 local first=math.huge
                            for _,q in path.samples do
                                if flat(hit.Position,q.p)<=range and math.abs(hit.Position.Y-q.p.Y)<=range then
                                    if (leak and q.s>=leak.progress) or (not leak and q.s<=(spawnFront and path.length*0.30 or frontEnd(path,range))) then
                                        coverage+=q.w first=math.min(first,q.s)
                                    end
                                end
                            end
                            if incoming then valid=valid and flat(hit.Position,incoming.p)>range+1
                                and first>incoming.progress+math.max(2,incoming.speed*2) end
                            local score=coverage*(leak and 1 or (1-0.7*math.min(first/(spawnFront and path.length*0.30 or frontEnd(path,range)),1)))
                            if valid and coverage>0 and (not anchorWinner or score>anchorWinner.score) then
                                anchorWinner={position=hit.Position,coverage=coverage,score=score,first=first,progress=progress,
                                    key=math.floor(hit.Position.X/1.5)..":"..math.floor(hit.Position.Z/1.5),path=path,
                                    mode=leak and "REAR INTERCEPT" or "FRONT",unit=unit,stacked=true}
                            end
                        end
                    end
                end
            end
        end
        if anchorWinner then winner=anchorWinner end
    end
    if winner then
        S.lastPlan=winner
        detail.Text=string.format("%s | %s | ATK ~%.1f | coverage %.1f | leaks %d",winner.mode,unit.id,unit.attack,winner.coverage,#leaks)
    end
    S.lastPlanMs=(os.clock()-planStart)*1000
    perf.planCandidates=candidates
    saveMapCache(pathList,groundCache)
    return winner
end
