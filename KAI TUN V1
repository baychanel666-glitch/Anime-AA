local function lockedFrontCandidate(choices,target)
    -- Use the same rarity/potential ranking as team assembly and front placement.
    -- When Elyssia is the team leader, the real frontline attacker carries defense upgrades.
    local leader=S.frontSupport or S.frontLeader
    if leader then
        local strongest
        for _,c in choices do
            if c.role=="FRONT" and c.stats and val(c.stats,"uuid")==leader.uuid then
                if c.unit==target then return c end
                if not strongest or c.attack>strongest.attack then strongest=c end
            end
        end
        if strongest then return strongest end
    end
    local current,best
    for _,c in choices do if c.role=="FRONT" then
        if c.unit==target then current=c end
        if not best or c.rank and (not best.rank or S.betterPotential(c.rank,best.rank))
            or not c.rank and not best.rank and c.attack>best.attack then best=c end
    end end
    if current and (not best or not best.rank or not current.rank
        or not S.betterPotential(best.rank,current.rank)) then return current end
    return best
end
