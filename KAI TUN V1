local function roundTick()
    if S.enforceStarterIntermission and S.enforceStarterIntermission() then return true end
    if rewardTick() then return true end
    local data=workspace:FindFirstChild("_DATA")
    local finished=val(data,"GameFinished")==true
    if finished and S.observeArcResult then S.observeArcResult() end
    -- Give the independent summon watcher priority over Next/Retry on a completed act.
    if finished and (S.summonCheckDue or S.summonResultDue()) and S.hasSummonTargets()~=false then return true end
    if not finished then
        S.resultSent=false S.infiniteResultReadyAt=nil
        if S.autoStart and val(data,"GameStarted")~=true then
            local vote=pg:FindFirstChild("VoteStart")
            local holder=vote and vote:FindFirstChild("Holder")
            local buttons=holder and holder:FindFirstChild("ButtonHolder")
            if click(buttons and buttons:FindFirstChild("Yes")) then status.Text="Voted to start" end
        end
        return false
    end
    if S.resultSent and os.clock()-(S.resultVoteAt or 0)<8 then return true end
    local results=pg:FindFirstChild("ResultsUI")
    if not results or not results.Enabled then return true end
    local holder=results:FindFirstChild("Holder") local title=holder and holder:FindFirstChild("Title")
    local word=title and string.upper(title.Text) or ""
    local victory=word=="VICTORY" and true or nil
    if word=="DEFEAT" then victory=false end
    local ld=Loader.LevelData or {}
    if S.recordStarterOutcome then S.recordStarterOutcome(victory,ld) end
    if S.starterSummon and S.starterSummon.navigationPaused and S.starterSummon.phase=="FIRST_RUN" then return true end
    if ld.infinite and (S.autoInfinite or S.autoInfiniteRetry) then
        local finished=results:FindFirstChild("Finished")
        if not finished or not finished.Visible then return true end
        S.infiniteResultReadyAt=S.infiniteResultReadyAt or os.clock()
        if os.clock()-S.infiniteResultReadyAt<10 then status.Text="Infinite results confirmed; waiting for reward save" return true end
        if S.infiniteRetryAllowed(ld.infinite) then
            local target=finished:FindFirstChild("NextRetry")
            if not visible(target) then status.Text="Infinite retry unavailable; waiting for results button" return true end
            S.resultSent=true S.resultVoteAt=os.clock() S.lastRoundVote="replay"
            S.saveSettings()
            getgenv().AAInvokeConnected(R.endpoints.client_to_server.set_game_finished_vote,"replay")
            status.Text="Infinite retry: no Summon targets selected"
            return true
        end
        if os.clock()-(S.infiniteReturnSentAt or -math.huge)>=8 then
            S.infiniteReturnSentAt=os.clock() S.saveSettings() invoke("teleport_back_to_lobby")
        end
        return true
    end
    if arcOutcome and arcOutcome(victory,ld) then return true end
    if S.enforceStarterIntermission and S.enforceStarterIntermission() then return true end
    -- Only the dedicated Infinite branch above may request replay.
    -- Story / World Skip continue through arcOutcome and normal next-act progression.
    local action=resultAction(victory,S.autoNext,false,ld._is_actual_storymode==true)
    if not action then
        status.Text=word=="VICTORY" and "Won; no supported next Story act available" or "Results ready; corresponding auto action is OFF"
        return true
    end
    -- Portal/contract/dungeon replay needs a separate item selection; never choose one automatically.
    if action=="replay" and (ld._is_map_or_portal_level or ld._event_contract or ld._dungeon) then
        status.Text="Replay requires a portal/contract/dungeon selection" return true
    end
    local finish=results:FindFirstChild("Finished")
    local target=finish and finish:FindFirstChild(action=="next_story" and "NextLevel" or "NextRetry")
    if visible(target) then
        -- Send the same verified vote as the game's button. Some executor GUI
        -- signals return successfully without running the game callback.
        S.resultSent=true S.resultVoteAt=os.clock()
        S.lastRoundVote=action
        getgenv().AAInvokeConnected(R.endpoints.client_to_server.set_game_finished_vote,action)
        status.Text=action=="next_story" and "Voted next Story act (retry after 8s if still here)" or "Voted retry after defeat"
    else
        if finish and finish.Visible and target and not target.Visible then
            status.Text=action=="next_story" and "Next act unavailable; waiting for your choice" or "Retry unavailable in this mode"
            return true
        end
        local buttons=holder and holder:FindFirstChild("Buttons")
        click(buttons and buttons:FindFirstChild("Next"))
    end
    return true
end
