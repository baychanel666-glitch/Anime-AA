local function baseHitsAir(unit)
    if unit.def.hill_unit or unit.def.hybrid_placement then return true end
    local attacks=R.src.Data:FindFirstChild("Attacks")
    if attacks and unit.def.primary_attack_no_upgrades then
        local definitions=require(attacks)
        local a=definitions[unit.def.primary_attack_no_upgrades]
        return a and a.targets_flying==true or false
    end return false
end
local function enemyIsAir(enemy)
    local st=enemy:FindFirstChild("_stats") local d=defs[val(st,"id")] or {}
    for _,key in {"flying","is_flying","air_unit","_flying"} do
        local v=val(st,key)
        if v==nil and st then v=st:GetAttribute(key) end
        if v==nil then v=enemy:GetAttribute(key) end
        if v==true or (type(v)=="number" and v>0) or d[key]==true then return true end
    end return false
end
-- Spawned models can appear before their attack stats replicate. Native helpers index
-- primary_attack directly; isolate that transient state from the decision worker.
local function safeCanTargetAir(fn,unit)
    if not fn or not unit or not unit.Parent then return false end
    local stats=unit:FindFirstChild("_stats")
    if not stats or not stats:FindFirstChild("primary_attack") then return false end
    local ok,result=pcall(fn,unit)
    if not ok then S.airCheckError=tostring(result):sub(1,160) return false end
    return result==true
end
function S.emergencyUpgradeEligible(candidate,threat)
    local id=val(candidate.stats,"id")
    local definition=defs[id] or {}
    local canDamage=matchup({def=definition},threat.enemy).immune>0
    if not canDamage then return false end
    -- Ground targeting behavior is unchanged here; this guard fixes the verified air hole.
    if not enemyIsAir(threat.enemy) then return true end
    local nativeAir=cachedLookup("function",{Name="unit_can_target_air"},true)
    local env=nativeAir and getfenv(nativeAir)
    local extra=candidate.unit:GetAttribute("_targets_flying")
    local nextAir=E.AALiveAuditModules.nextAir(definition,candidate.level,env and env.Attacks,
        val(candidate.stats,"primary_attack"),type(extra)=="number" and extra>0)
    return E.AALiveAuditModules.upgradeEligibility({farm=S.isDevelopmentFarm(definition),
        direct=S.isDirectCombatId(id)},{air=true},{canDamage=canDamage,
        currentAir=safeCanTargetAir(nativeAir,candidate.unit),nextAir=nextAir,reaches=true})
end
function S.frontAirUpgradeChoice(choices,budget,now,urgentOnly)
    if not S.airDefense then return nil end
    local canAir=cachedLookup("function",{Name="unit_can_target_air"},true)
    local routes=paths()
    local pressure={}
    if urgentOnly then
        for _,enemy in S.enemyPressure or {} do
            if enemy.unit.Parent and enemyIsAir(enemy.unit) and enemy.progress/enemy.path.length<=0.50 then
                local capacity=0
                for _,u in ownUnits() do
                    local at=project(u.p,enemy.path)
                    if at<=enemy.path.length*0.30 and S.isStandingDefender(u) and safeCanTargetAir(canAir,u.unit)
                        and matchup({def=defs[val(u.stats,"id")] or {}},enemy.unit).immune>0 then
                        local range=tonumber(val(u.stats,"range")) or 0
                        local coverage=pathCoverage(u.p,range,enemy.path,enemy.progress,enemy.path.length)
                        local speed=math.max(tonumber(val(enemy.unit:FindFirstChild("_stats"),"speed")) or 4,1)
                        local cd=math.max(tonumber(val(u.stats,"attack_cooldown")) or 1,0.1)
                        local competing=0
                        for _,other in S.enemyPressure or {} do
                            if other.path==enemy.path and other.unit.Parent and enemyIsAir(other.unit)
                                and pathCoverage(u.p,range,other.path,other.progress,other.path.length)>0 then competing+=1 end
                        end
                        capacity+=(tonumber(val(u.stats,"damage")) or 0)/cd*math.max(0,coverage/speed-cd*0.5)/math.max(1,competing)
                    end
                end
                if capacity<(enemy.health or math.huge)*1.25 then pressure[#pressure+1]=enemy end
            end
        end
        if #pressure==0 then return nil end
    end
    local best
    for _,c in choices do
        if c.role=="FARM" or c.cost>budget or now<(c.readyAt or 0)
            or not S.isDirectCombatId(val(c.stats,"id")) or not safeCanTargetAir(canAir,c.unit) then continue end
        local useful=false
        for _,path in routes do
            local at=project(c.position,path)
            if at<=path.length*0.30 and pathCoverage(c.position,c.nextRange or 0,path,0,path.length*0.30)>0 then
                if not urgentOnly then useful=true break end
                for _,enemy in pressure do
                    if enemy.path==path and matchup({def=defs[val(c.stats,"id")] or {}},enemy.unit).immune>0
                        and pathCoverage(c.position,c.nextRange or 0,path,enemy.progress,path.length)>0 then useful=true break end
                end
            end
            if useful then break end
        end
        if useful and (not best or c.value>best.value or c.value==best.value and c.attack>best.attack) then best=c end
    end
    return best
end
function S.preferDefenseUnit(candidate,current)
    if not current then return true end
    local ranks=S.placementTeamRanks or {}
    local a,b=ranks[candidate.uuid],ranks[current.uuid]
    if a and b then return S.betterPotential(a,b) end
    if a~=nil or b~=nil then return a~=nil end
    return candidate.cost<current.cost
end
function S.pickOpeningGuardScored(rows,cash,progress)
    local viable,save,best
    for _,r in rows do
        if r.ratio>=1 then
            if not save or r.unit.cost<save.unit.cost then save=r end
            if r.unit.cost<=cash and (not viable or S.preferDefenseUnit(r.unit,viable.unit)) then viable=r end
        end
        if r.unit.cost<=cash and (not best or r.ratio>best.ratio
            or r.ratio==best.ratio and r.unit.cost<best.unit.cost) then best=r end
    end
    if viable then return viable,"EXPECTED TO HOLD" end
    if save and (progress or 0)<0.35 then return save,"SAVE FOR VIABLE GUARD" end
