                cashBefore=cashBefore,cashAfter=tonumber(val(P:FindFirstChild("_stats"),"resource")) or 0}
            if confirmed then
                if farm then S.farmsSold=(S.farmsSold or 0)+1 else S.passedUnitsSold=(S.passedUnitsSold or 0)+1 end
            end
