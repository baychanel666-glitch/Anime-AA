function S.hourlySummonTick()
    if not S.instanceGuard then return end
    local ok,watch=pcall(E.AAReadSummonWatch)
    if not ok then return end
    local due=S.hourlyWatchDue(watch)
    if type(watch)~="table" or watch.active~=true then return end
    if S.starterSummon and S.starterSummon.active and not S.starterSummon.done then return end
    -- The ordinary watcher prunes owned targets. An explicitly empty selection never exits a match.
    if S.hasSummonTargets()~=true then return end
