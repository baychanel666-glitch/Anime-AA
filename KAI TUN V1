local function equipInventoryTeam(plan)
    if not S.autoTeam then return true end
    if not Loader.IsLobby or not S.alive or S.teamEquipBusy or S.developmentBusy or not plan then return false end
    if not liveEquipController then
        liveEquipController=E.AALiveAuditModules.equip({clock=os.clock,matches=E.AALiveAuditModules.matches,
            minimumInterval=1.25,idempotentRetryAfter=3,maxAttempts=2,
            read=function()
                local ss=Loader.load_client_service(script,"UnitCollectionServiceClient").session
                local _,slots=liveUnlockedSlots(ss)
                return {profile=ss and ss.collection and ss.collection.collection_profile_data,slots=slots}
            end,
            send=function(uuid,slot)
                liveAuditEvent("EQUIP_REQUEST",{uuid=uuid,slot=slot})
                local returned=table.pack(getgenv().AAInvokeConnected(endpoints.equip_unit,uuid,slot))
                liveAuditEvent("EQUIP_REPLY",{count=returned.n,firstType=typeof(returned[1]),first=type(returned[1])~="table" and tostring(returned[1]) or "table"})
                return table.unpack(returned,1,returned.n)
            end})
        pcall(function()
            local saved=game:GetService("HttpService"):JSONDecode(readfile("AASmartPlacement/live_starter_"..P.UserId..".json"))
            if saved.pending then
                -- Server outcome is still unknown across teleport; never resend blindly.
                saved.pending.started=os.clock()
                liveEquipController.pending=saved.pending
            end
        end)
    end
    liveEquipController.start()
    S.liveEquipController=liveEquipController
    S.teamEquipBusy=true
    local revision=S.bestTeamEquipRevision or 0
    local generation=S.generation
    local ok,confirmed=pcall(function()
        local deadline=os.clock()+20 local previous
        repeat
            if not S.alive or not S.autoTeam or S.generation~=generation then liveEquipController.stop() return false end
            local done,why=liveEquipController.tick(plan)
            S.teamEquipStatus=why
            if why~=previous then liveAuditEvent("EQUIP_STATE",{status=why,pending=liveEquipController.pending}) previous=why end
            if done then
                -- Summons or development may change inventory while native Equip yields.
                local fresh=chooseInventoryTeam()
                local profile=S.collectionProfile()
                if not fresh or not profile or not S.teamMatchesPlan(profile,fresh) then
                    S.requestBestTeam("Inventory changed during Equip confirmation")
                    liveAuditEvent("EQUIP_STALE_CONFIRMATION",{previousCount=#plan.team})
                    return false
                end
                S.inventoryTeam=fresh
                local confirmedTeam={}
                for _,row in ipairs(fresh.team) do confirmedTeam[#confirmedTeam+1]={id=row.id,uuid=row.uuid} end
                S.lastLiveEquipConfirmed={job=game.JobId,time=os.time(),count=#fresh.team,team=confirmedTeam}
                liveAuditEvent("EQUIP_CONFIRMED",{count=#fresh.team,team=confirmedTeam})
                return true
            end
            if why=="INVALID_OR_STALE_PLAN" or why=="ADAPTER_ERROR" then return false end
            task.wait(0.1)
        until os.clock()>=deadline
        return false
    end)
    S.teamEquipBusy=false
    if not ok then S.teamEquipError=tostring(confirmed) liveAuditEvent("EQUIP_ERROR",{error=tostring(confirmed)}) return false end
    S.teamEquipError=nil
    if confirmed==true and revision==(S.bestTeamEquipRevision or 0) then S.bestTeamEquipPending=false end
    return confirmed==true
end
