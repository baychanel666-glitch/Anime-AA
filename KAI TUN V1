            end
            S.starterSummonStatus="Waiting for starter summon results" return
        end
        if balance<unitCost then
            finishSummonRound()
            return
        end
        if os.clock()<(E.AASummonNextRequestAt or 0) then return end
        local count=0 for _ in pairs(profile.owned_units) do count+=1 end
        local capacity=tonumber(profile.capacity)
        local batch=balance>=unitCost*10 and 10 or 1
        if capacity and count+batch>capacity then
            if count<capacity then batch=1 else
                S.starterSummonStatus="Collection full; waiting for free space" return
            end
        end
        if state.phase~="INITIAL_SUMMON" and state.phase~="SECOND_SUMMON" then return end
        if not state.active or state.done or not E.AAStarterSetupActive then return end
