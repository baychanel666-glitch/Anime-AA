            if message:find("expired",1,true) or message:find("invalid",1,true) then log.terminal=true end
            S.codeRedeemLog[code]=log S.codeRedeemBusy=false
            S.codeRedeemStatus=code..": "..(log.confirmed and "confirmed / already redeemed" or message~="" and message or "submitted; waiting for confirmation")
