local function advanceArcFallback(previous,victory,act,lastAct,sequential)
    local row=table.clone(previous or {wins=0,losses=0})
    if victory then
        row.stageWins=(row.stageWins or 0)+1
        if sequential and act<lastAct then row.sequential=true row.nextAct=act+1
        else row.wins=(row.wins or 0)+1 row.sequential=false row.nextAct=nil end
    else
        row.losses=(row.losses or 0)+1
        row.sequential=true row.nextAct=sequential and act or 1
    end
    if previous and previous.foodFarm then
        row.foodFarm=true row.sequential=true
        row.nextAct=victory and (act<lastAct and act+1 or 1) or act
        if victory and act>=lastAct then row.farmCycles=(row.farmCycles or 0)+1 end
    end
    return row
end
S.testArcFallback=function()
    local failed=advanceArcFallback({},false,6,6,false)
    local won1=advanceArcFallback(failed,true,1,6,true)
    local failed2=advanceArcFallback(won1,false,2,6,true)
    local finished=advanceArcFallback(failed2,true,6,6,true)
    local farmNext=advanceArcFallback({foodFarm=true,sequential=true},true,1,6,true)
    local farmLoop=advanceArcFallback({foodFarm=true,sequential=true},true,6,6,true)
    return {foodFarmAdvances=farmNext.nextAct==2 and farmNext.foodFarm,
        foodFarmLoopsAfterFinal=farmLoop.nextAct==1 and farmLoop.sequential,
        skipDefeatStartsAct1=failed.sequential and failed.nextAct==1,
        winAdvancesToAct2=won1.nextAct==2,normalDefeatRetriesSameAct=failed2.nextAct==2,
        lastActWinEndsFallback=not finished.sequential and finished.nextAct==nil}
end
function S.storyWorldRows()
    if S.storyWorldCache then return S.storyWorldCache end
    local worlds=require(R.src.Data.Worlds) local levels=require(R.src.Data.Levels)
