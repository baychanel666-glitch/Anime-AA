    end
    function S.nextStarterPhase(phase,event)
        if phase=="IDLE" and event=="QUALIFIED" then return "INITIAL_SUMMON" end
        if phase=="INITIAL_SUMMON" and event=="GEMS_EXHAUSTED" then return "FIRST_RUN" end
        if phase=="FIRST_RUN" and event=="FIRST_VICTORY" then return "FIRST_REWARDS" end
        if phase=="FIRST_REWARDS" and event=="RESULTS_CONFIRMED" then return "CLAIM_STORY" end
        if phase=="CLAIM_STORY" and event=="STORY_CLAIMED" then return "SECOND_SUMMON" end
        if phase=="SECOND_SUMMON" and event=="GEMS_EXHAUSTED" then return "REBUILD_TEAM" end
        if phase=="REBUILD_TEAM" and event=="TEAM_CONFIRMED" then return "SECOND_RUN" end
        if phase=="SECOND_RUN" and event=="SECOND_ENTER" then return "DONE" end
        if phase=="SECOND_RUN" and event=="SECOND_RESULT" then return "DONE" end
        return phase
    end
