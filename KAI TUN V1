function S.recordArcOutcome(victory,ld)
    if S.hourlyReturnPending then return false end
    if ld.infinite then return false end
    if not S.arcWorld or S.arcWorld=="" or victory==nil or ld.world~=S.arcWorld then return false end
    if S.arcResultRecorded then return true end
    loadArcHistory()
    local previous=arcHistory[S.arcWorld] or {wins=0,losses=0}
    if previous.lastResultJob==game.JobId then S.arcResultRecorded=true return true end
    local world=require(R.src.Data.Worlds)[S.arcWorld]
    local lastAct=0
    for k in pairs(world and world.levels or {}) do lastAct=math.max(lastAct,tonumber(k) or 0) end
    local act=tonumber(ld.story_level_rank) or 1
    local kind=S.arcRunKind
    if kind~="skip" and kind~="act" then
        pcall(function()
            local active=game:GetService("HttpService"):JSONDecode(readfile("AASmartPlacement/active_arc_"..P.UserId..".json"))
            if active.world==ld.world and active.stage==ld.id then kind=active.worldSkip and "skip" or "act" end
        end)
    end
    if kind~="skip" and kind~="act" then kind=previous.sequential and "act" or "skip" end
    local row=advanceArcFallback(previous,victory,act,lastAct,kind=="act")
    S.updateInfiniteRecovery(previous,row,victory,kind,act,lastAct)
    if not victory then row.failedAttack=S.arcMainAttack or 0 end
    row.stage=ld.id or S.arcStage row.updated=os.time()
    row.lastResultJob=game.JobId row.lastResultVictory=victory row.lastResultKind=kind
    if kind=="skip" then
        local ss=session()
        if ss then S.markSkipTeamAttempt(row,ss.collection.collection_profile_data) end
    end
    arcHistory[S.arcWorld]=row
    local ss=session()
    if ss then S.reconcileCompletedArcHistory(arcHistory,ss.profile_data.level_data.completed_story_levels,require(R.src.Data.Worlds)) end
    saveArcHistory()
    S.saveSettings()
    if S.infiniteRecoveryEligible(row) then
        status.Text="World Skip and fallback act defeated; recover in Infinite"
    elseif row.sequential then
        status.Text="Auto Arc: return for Act "..row.nextAct.." | "..(victory and "previous act cleared" or "retry through normal acts")
    else status.Text="Arc cleared: returning to choose next arc" end
    S.arcResultRecorded=true
    return true
end
