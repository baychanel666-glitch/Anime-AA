    local counts,byId,observed={},{},{}
    for _,u in ownUnits() do
        local uuid=val(u.stats,"uuid") local id=val(u.stats,"id")
        if S.accumulatePlacementCount(counts,byId,uuid,id) then
            local d=defs[id] local n=val(u.stats,"upgrade") or 0
            local stage=d and n>0 and d.upgrade and d.upgrade[n] or d
            if stage and (tonumber(stage.damage) or 0)>0 and (tonumber(stage.range) or 0)>0 then
                observed[uuid]={damage=(val(u.stats,"damage") or stage.damage)/stage.damage,
                    range=(val(u.stats,"range") or stage.range)/stage.range,
                    cooldown=(val(u.stats,"attack_cooldown") or stage.attack_cooldown or 1)/math.max(stage.attack_cooldown or 1,0.1)}
            end
        end
    end
    local a={} local leader local support local hasElyssia=false
    local rankingSession=S.unitPotential and S.playerSession()
    S.placementTeamRanks={}
    for _,uuid in pairs(profile.equipped_units) do
        local o=profile.owned_units[uuid] local d=o and defs[o.unit_id]
        if d and type(d.damage)=="number" and d.damage>0 and type(d.range)=="number" then
            local modifier=observed[uuid] or S.spawnMultipliers(uuid,o,rankingSession)
            local c=counts[uuid] or 0
            local strength=d.damage*(modifier and modifier.damage or 1)
            local rank=S.unitPotential and S.unitPotential(uuid,o,rankingSession)
            rank=rank or {uuid=uuid,rarityRank=({Secret=6,Mythic=5,Exclusive=5,Legendary=4,Epic=3,Rare=2})[d.rarity] or 1,potential=strength}
            S.placementTeamRanks[uuid]=rank
            if d.shared_setup_script=="elyssia" or o.unit_id=="elyssia" then hasElyssia=true end
            if S.isDirectCombatId(o.unit_id) and (not support or strength>support.attack
                or strength==support.attack and S.betterPotential(rank,support.rank)) then
                support={uuid=uuid,id=o.unit_id,attack=strength,count=c,rank=rank}
            end
            if not leader or S.betterPotential(rank,leader.rank) then leader={uuid=uuid,id=o.unit_id,attack=strength,count=c,rank=rank} end
            local maximum=tonumber(d.spawn_cap)
            if o.unit_id=="wendy" and E.FyrelithSkyRotation then maximum=math.min(maximum or 4,4) end
            local capped=maximum and (byId[o.unit_id] or 0)>=maximum
            local blocked=S.caps[uuid]
            -- Learned server caps expire when a placed copy disappears.
            if blocked and c<blocked then S.caps[uuid]=nil blocked=nil end
            if not capped and not blocked and os.clock()>=(S.skips[uuid] or 0) then
                a[#a+1]={uuid=uuid,id=o.unit_id,def=d,attack=d.damage*(modifier and modifier.damage or 1),
                    range=d.range*(modifier and modifier.range or 1),cooldown=(d.attack_cooldown or 1)*(modifier and modifier.cooldown or 1),cost=d.cost or math.huge,count=c}
            end
        end
    end
    S.teamPotentialLeader=leader
    S.frontLeader=support or leader
    S.frontSupport=hasElyssia and support or nil
    S.hasElyssia=hasElyssia
    table.sort(a,function(x,y) return S.betterPotential(S.placementTeamRanks[x.uuid],S.placementTeamRanks[y.uuid]) end)
    return a
end
