        end
        table.sort(acts,function(a,b) return a.rank<b.rank end)
        if #acts>0 then rows[#rows+1]={id=id,name=w.name or id,world=w,acts=acts,first=acts[1],last=acts[#acts]} end
    end
    S.storyWorldCache=rows return rows
end
function S.prepareStoryMapKnowledge(currentMap,geometryFile)
    local file="AASmartPlacement/maps/story_index.json"
    local previous={}
    pcall(function()
        if type(isfile)=="function" and isfile(file) then
            local saved=game:GetService("HttpService"):JSONDecode(readfile(file))
            if saved.version==1 then previous=saved.maps or {} end
        end
    end)
    local maps=require(R.src.Data.Maps) local levels=require(R.src.Data.Levels)
    local index={version=1,updated=os.time(),worlds={},maps={}}
    local total,cached,acts=0,0,0
    for _,world in ipairs(S.storyWorldRows()) do
        local row={id=world.id,name=world.name,acts={}}
        for _,act in ipairs(world.acts) do
            local level=levels[act.id] local id=level and level.map
            if id then
                acts+=1 row.acts[#row.acts+1]={id=act.id,act=act.rank,map=id}
                if not index.maps[id] then
                    total+=1
                    local old=previous[id] or {}
                    local known=old.geometryFile
                    if currentMap==id and geometryFile then known=geometryFile end
                    local available=type(isfile)=="function" and known and isfile(known) or false
                    local packaged
                    for signature,data in pairs(E.AAEmbeddedMapCache or {}) do
                        if data.mapId==id and data.version==1 and type(data.paths)=="table" and #data.paths>0 then
                            packaged=signature break
                        end
                    end
                    index.maps[id]={id=id,name=maps[id] and maps[id].name or id,
                        geometryFile=available and known or nil,embeddedSignature=packaged,
                        status=packaged and "EMBEDDED_AVAILABLE" or available and "SCANNED_CACHE" or "METADATA_ONLY"}
                    if available or packaged then cached+=1 end
                end
            end
        end
        index.worlds[#index.worlds+1]=row
    end
    S.storyMapKnowledge={worlds=#index.worlds,acts=acts,maps=total,cached=cached,
        missing=total-cached,file=file,allGeometryCached=total>0 and cached==total}
    local ok,err=pcall(function()
        assert(type(writefile)=="function","Executor file storage unavailable")
        if not isfolder("AASmartPlacement") then makefolder("AASmartPlacement") end
        if not isfolder("AASmartPlacement/maps") then makefolder("AASmartPlacement/maps") end
        writefile(file,game:GetService("HttpService"):JSONEncode(index))
    end)
    S.storyMapKnowledge.saved=ok
    if not ok then S.storyMapKnowledge.error=tostring(err):sub(1,160) end
    return S.storyMapKnowledge
end
