function S.reconcileCompletedArcHistory(history,completed,worlds)
    local changed=false
    for id,row in pairs(history) do
        local world=worlds[id] local lastRank=0 local last
        for rank,act in pairs(world and world.levels or {}) do
            if (tonumber(rank) or 0)>lastRank then lastRank=tonumber(rank) last=act end
        end
        local clear=last and completed and completed[last.id]
        -- Explicit food-farming loops retain their own policy. Failed-skip replay cursors do not.
        if not row.foodFarm and clear and (tonumber(clear.times_completed) or 0)>0
            and (row.sequential or row.nextAct or row.skipFailed or row.infiniteRecovery) then
            row.sequential=false row.nextAct=nil row.skipFailed=false row.infiniteRecovery=false
            row.reconciledStage=last.id row.reconciledReason="Server confirms final story act completed"
            changed=true
        end
    end
    return changed
end
local function nextArcGoal()
    local ss=session() if not ss then return nil end
    local order=require(R.src.Data.WorldLevelOrder) local worlds=require(R.src.Data.Worlds)
    local levels=require(R.src.Data.Levels)
    local check=cachedLookup("function",{Name="check_if_unlocked_level"},true)
    local completed=ss.profile_data.level_data.completed_story_levels
    if S.reconcileCompletedArcHistory(arcHistory,completed,worlds) then saveArcHistory() end
    if S.autoInfinite then
        for _,id in ipairs(order.WORLD_ORDER) do
            local row=arcHistory[id]
            if S.infiniteRecoveryEligible(row) then
                local profile=ss.collection.collection_profile_data
                local fresh=S.newEquippedMythics(profile,row.mythicSkipRetried)
                if not row.skipTeams then S.markSkipTeamAttempt(row,profile) saveArcHistory() end
                local changedTeam=S.hasUntriedSkipTeam(row,profile)
                if next(fresh) or changedTeam then
                    row.infiniteRecovery=false saveArcHistory()
                else return S.chooseInfiniteGoal("story_failure",id) end
            end
        end
    end
    -- Server skip can mark earlier acts completed; the local replay cursor takes precedence.
    for _,id in ipairs(order.WORLD_ORDER) do
        local history=arcHistory[id] local world=worlds[id]
        if history and history.sequential and world and world.levels then
            local rank=math.max(1,tonumber(history.nextAct) or 1)
            local selected=world.levels[tostring(rank)]
            -- A failed World Skip may leave an Act-6 cursor even though normal Act 6 is locked.
            -- Resume through Act 1 instead of waiting forever for that cursor to unlock itself.
            if selected and check and not check(ss.profile_data.level_data,selected.id) then
                local first=world.levels["1"]
                if first and check(ss.profile_data.level_data,first.id) then
                    rank=1 selected=first history.nextAct=1
                    history.fallbackReason="Saved replay act locked; restart normal Act 1"
                    saveArcHistory()
                    S.arcCursorRecovery={world=id,act=1,reason=history.fallbackReason}
                else selected=nil end
            end
            if selected then return {world=id,name=world.name or id,id=selected.id,
                recommended=world.recommended_level or 0,rank=rank,level=levels[selected.id],sequential=true,foodFarm=history.foodFarm==true} end
        end
    end
    for _,w in ipairs(S.storyWorldRows()) do
        local done=completed[w.last.id]
        if not (done and (tonumber(done.times_completed) or 0)>0) then
            if not check or not check(ss.profile_data.level_data,w.first.id) then return nil end
            if not order.SKIPPABLE_WORLDS[w.id] then
                for _,act in ipairs(w.acts) do
                    local cleared=completed[act.id]
                    if not (cleared and (tonumber(cleared.times_completed) or 0)>0) then
                        if not check(ss.profile_data.level_data,act.id) then return nil end
                        return {world=w.id,name=w.name,id=act.id,recommended=w.world.recommended_level or 0,
                            rank=act.rank,level=levels[act.id],sequential=true}
                    end
                end
            end
            return {world=w.id,name=w.name,id=w.last.id,recommended=w.world.recommended_level or 0,
                rank=w.last.rank,level=levels[w.last.id]}
        end
    end
