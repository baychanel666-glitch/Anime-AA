local function arcDevelop(plan,required)
    if S.autoFeedSelected or S.autoFuseSelected or S.autoBestDevelopment then return false end
    if not Loader.IsLobby or not S.enabled or not S.autoArcSkip then return false end
    local ss=session() if not ss then return false end
    local profile=ss.collection.collection_profile_data
    local target
    -- The strongest main unit gets food first; other damage units receive Rare/Epic fusions.
    if plan.primary and (plan.primary.level or 0)<required then target=plan.primary end
    if not target then
        for _,row in plan.team do
            if row.attack>0 and row.farm==0 and (row.level or 0)<required and (not target or row.attack>target.attack) then target=row end
        end
    end
    if not target then return false end
    local own=profile.owned_units[target.uuid] local def=own and defs[own.unit_id]
    if not def or (def.farm_amount or 0)>0 or (def.damage or 0)<=0 then return false end
    local xpFn=cachedLookup("function",{Name="calculate_xp",Constants={"pow"}},true)
    if not xpFn then status.Text="Auto development: waiting for the game's XP calculator" return false end
    local need=math.max(0,xpFn(own.unit_id,required)-(own.xp or 0))
    if need<=0 then return false end
    local function finish(kind,material,request)
        local before=own.xp or 0
        local started=os.clock()
        local ok,reply=pcall(request)
        local deadline=os.clock()+2
        repeat
            if not S.alive then return true end
            if (own.xp or 0)>before then break end task.wait(0.03)
        until os.clock()>=deadline
        local confirmed=(own.xp or 0)>before
        S.lastArcDevelopment={kind=kind,target=target.id,uuid=target.uuid,before=before,after=own.xp or 0,
            material=material,confirmed=confirmed,reply=tostring(reply),ok=ok,milliseconds=(os.clock()-started)*1000}
        pcall(function() writefile("AASmartPlacement/last_arc_development.json",game:GetService("HttpService"):JSONEncode(S.lastArcDevelopment)) end)
        if not confirmed then
            if kind=="FOOD" then S.arcAutoFeed=false else S.arcAutoFuse=false end
            S.saveSettings() extensionSync()
            status.Text="Auto "..kind..": XP unconfirmed; this feature paused to prevent repeated spending"
        else status.Text="Auto "..kind..": "..target.id.." XP "..math.floor(before).." -> "..math.floor(own.xp or 0) end
        return true
    end
    if S.arcAutoFeed and plan.primary and target.uuid==plan.primary.uuid then
        local f=cachedLookup("function",{Constants={"LevelUpFeed"}},true)
        local util=f and getfenv(f).LevelUtil
        local itemFn=cachedLookup("function",{Name="_handle_use",Constants={"feed_units"}},true)
        local items=itemFn and getfenv(itemFn).Items
        local foods={}
        for _,id in pairs(util and util.xp_items or {}) do
            local item=items and items[id] local usage=item and item.usage
            local amount=ss.inventory:get_number_of_owned_item(id)
            if usage and usage.type=="xp_feed" and (usage.xp_amount or 0)>0 and amount>0 then
                foods[#foods+1]={id=id,xp=usage.xp_amount,count=amount}
            end
        end
        -- Send a mixed-item batch in one request, stopping at the required XP.
        table.sort(foods,function(a,b)return a.xp>b.xp end)
        local batch={} local remaining=need local total=0
        for _,food in foods do
            local amount=math.min(food.count,math.floor(remaining/food.xp))
            if amount>0 then batch[food.id]=amount remaining-=amount*food.xp total+=amount end
        end
        if remaining>0 then
            for i=#foods,1,-1 do
                local food=foods[i]
                if food.count>(batch[food.id] or 0) then batch[food.id]=(batch[food.id] or 0)+1 total+=1 break end
            end
        end
        if total>0 then
            return finish("FOOD",{items=batch,count=total},function() return invoke("level_up_feed",target.uuid,batch) end)
        end
    end
    if S.arcAutoFuse then
        local equipped,wanted={},{}
        for _,uuid in pairs(profile.equipped_units) do equipped[uuid]=true end
        for _,row in plan.team do wanted[row.uuid]=true end
        local candidates={}
        for uuid,o in pairs(profile.owned_units) do
            local d=defs[o.unit_id]
            if fuseMaterialAllowed(o,d,equipped[uuid],wanted[uuid],target.uuid) then
                candidates[#candidates+1]={uuid=uuid,id=o.unit_id,xp=o.xp or 0,rarity=d.rarity}
            end
        end
        table.sort(candidates,function(a,b)
            if a.rarity~=b.rarity then return a.rarity=="Rare" end
            if a.xp==b.xp then return a.uuid<b.uuid end return a.xp<b.xp
        end)
        -- One donor at a time avoids consuming a large batch past the required level.
        local donor=candidates[1]
        if donor then
            return finish("FUSE",{uuid=donor.uuid,id=donor.id,rarity=donor.rarity},function()
                return invoke("feed_units",target.uuid,{donor.uuid})
            end)
        end
    end
    S.arcDevelopmentWait={target=target.id,requiredLevel=required,level=target.level,xpNeeded=need,reason="No allowed food/materials or development toggle is OFF"}
    return false
end
