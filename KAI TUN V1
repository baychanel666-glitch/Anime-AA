local Loader=require(R.src:WaitForChild("Loader",60))
local damageTypes=require(R.src.Data:WaitForChild("DamageTypes",60)).TYPES
local function damageInfo(enemy,key)
    local stats=enemy:FindFirstChild("_stats")
    local v=val(stats,key)
    if v==nil and stats then v=stats:GetAttribute(key) end
    if v==nil then v=enemy:GetAttribute(key) end
    if v==nil then local d=defs[val(stats,"id")] v=d and d[key] end
    return tonumber(v)
end
local function damageKinds(unit)
    local kinds={unit.def._base_damage_type or "physical"}
    for k,v in pairs(unit.def._secondary_damage_types or {}) do
        local key=type(k)=="number" and v or k
        if v and damageTypes[key] then kinds[#kinds+1]=key end
    end return kinds
end
local function matchup(unit,enemy)
    local result={immune=0,amp=0,res=math.huge,known=false}
    for _,kind in damageKinds(unit) do
        local immune=damageInfo(enemy,"immune_"..kind) or 0
        local amp=damageInfo(enemy,"_dmg_amp_"..kind)
        local resist=damageInfo(enemy,"_dmg_res_"..kind)
        if amp~=nil or resist~=nil or immune>0 then result.known=true end
        if immune<=0 then
            result.immune+=1 result.amp=math.max(result.amp,amp or 0)
            result.res=math.min(result.res,resist or 0)
        end
    end
    result.blocked=result.immune==0
    return result
end
selectCounter=function(units,enemy)
    local chosen,rank
    for _,unit in units do
        local r=matchup(unit,enemy)
        if not chosen or (rank.blocked and not r.blocked)
            or (r.blocked==rank.blocked and (r.amp>rank.amp or
                (r.amp==rank.amp and (r.res<rank.res or (r.res==rank.res and unit.attack>chosen.attack))))) then
            chosen=unit rank=r
        end
    end
    return chosen,rank
end
incomingCounter=function(ps,units)
    if not S.elementEnabled or #units==0 then return units[1],nil end
    local own=ownUnits() local targets={}
    local f=workspace:FindFirstChild("_UNITS")
    if f then for _,enemy in f:GetChildren() do
        local stats=enemy:FindFirstChild("_stats") local base=val(stats,"base")
        if base and base.Name=="pve" and enemy:IsA("Model") and (tonumber(val(stats,"health")) or 0)>0 then
            local pos=enemy:GetPivot().Position
            if not covered(pos,own) then
                for _,path in ps do
                    local lane=tostring(val(stats,"lane") or "")
                    if lane=="" or path.lane==lane then
                        local progress,distance=project(pos,path)
                        local unit,rank=selectCounter(units,enemy)
                        local previous=S.enemyMotion[enemy] local now=os.clock()
                        local speed=tonumber(val(stats,"speed")) or tonumber(val(stats,"starting_speed")) or 1
                        if previous and previous.path==path and now-previous.time>0.2 then
                            speed=math.max(speed,math.max(0,(progress-previous.progress)/(now-previous.time)))
                        end
                        S.enemyMotion[enemy]={progress=progress,time=now,path=path}
                        if unit and not rank.blocked and distance<12 and progress+unit.range+math.max(3,speed*2)<frontEnd(path,unit.range) then
                            targets[#targets+1]={unit=unit,enemy=enemy,path=path,progress=progress,p=pos,speed=speed,
                                known=rank.known,priority=progress/path.length}
                        end
                    end
                end
            end
        end
    end end
    table.sort(targets,function(a,b) return a.priority>b.priority end)
    local target=targets[1]
    if target then return target.unit,target end
    return units[1],nil
end
