            env.AASmartBootJob=nil log("startup-timeout","Runtime initialization did not finish within 90 seconds")
        end
    end)
    local ok,err=pcall(function()
        local cfg,src
        local deadline=os.clock()+30
        repeat
            local readOk=pcall(function()
                cfg=game:GetService("HttpService"):JSONDecode(readfile(%q))
                src=readfile(%q)
            end)
            if readOk and type(cfg)=="table" and type(src)=="string" then break end
            task.wait(0.25)
        until os.clock()>deadline
        assert(type(cfg)=="table" and type(src)=="string","Saved runtime/settings unavailable")
        if cfg.version~=2 or cfg.autorun~=true then return end
        env.AASmartPlacementRestore=cfg
        env.AASmartPlacementSource=src
        local compiled,compileError=loadstring(src)
        assert(compiled,compileError)
        log("runtime-starting")
        compiled()
        assert(env.AASmartPlacement and env.AASmartPlacement.alive,"Runtime did not initialize")
        log("running")
    end)
    completed=true
    if not ok then env.AASmartBootJob=nil log("failed",tostring(err)) warn("AA autorun: "..tostring(err)) end
end)
]],settingsFile,runtimeFile)
        assert(loadstring(payload),"Invalid autorun payload")
