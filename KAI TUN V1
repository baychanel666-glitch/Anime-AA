    if Loader.IsLobby then
        if due then
            S.saveHourlySummon(hourlyClock.consume(state,os.time(),nil,nil))
            watch.nextCheck=0 assert(E.AAWriteSummonWatch(watch))
            S.summonCheckDue=true
        end
