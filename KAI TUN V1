function S.routineFrontAirDecision(choices,budget,now)
    local leader=S.frontSupport or S.frontLeader
    if not leader or not S.airDefense then return nil,"NONE",0 end
    local mainMaxed=false local routes
    for _,u in ownUnits() do
        if val(u.stats,"uuid")==leader.uuid then
            local level=tonumber(val(u.stats,"upgrade"))
            local maximum=tonumber(val(u.stats,"max_upgrade"))
            local health=tonumber(val(u.stats,"health"))
            if level and maximum and level>=maximum and (not health or health>0) then
                routes=routes or paths()
                if roleFor(u,routes)=="FRONT" then mainMaxed=true break end
            end
        end
    end
    if not mainMaxed then return nil,"NONE",0 end
    local candidate=S.frontAirUpgradeChoice(choices,math.huge,now,false)
    local action,cost=E.AALiveAuditModules.frontAir(true,candidate,budget,now)
    return candidate,action,cost
end
local function upgrade(budget,generation,focus)
    if not S.upgradeEnabled or not upgradeRemote then return false end
    local choices=upgradeCandidates(focus=="FARM")
    if focus then
        local filtered={}
        for _,c in choices do if (focus=="FARM")== (c.role=="FARM") and (focus~="CARRY" or c.role=="FRONT") and (focus~="FINAL" or ((tonumber(val(c.stats,"damage")) or 0)>0 and not (S.finalRetired and S.finalRetired[c.unit]))) then
                if focus=="FINAL" then c.role="FRONT" end
                filtered[#filtered+1]=c
            end end
        choices=filtered
    end
    local c,priority
    if focus=="FINAL" then
        local support
        for _,candidate in choices do if candidate.unit==S.finalSupportTarget then support=candidate break end end
        if support and support.cost<=budget and os.clock()>=(support.readyAt or 0) then c=support
        else c=pickFinalUpgrade(choices,budget,os.clock()) end
    elseif focus=="FRONT AIR ROUTINE" then
        local action,cost
        c,action,cost=S.routineFrontAirDecision(choices,budget,os.clock())
        if action=="SAVE" or action=="WAIT" then
            S.upgradePriority="FRONT ANTI-AIR ROUTINE"
            status.Text="Front anti-air upgrade queued | cost "..cost
            return true
        end
        if action~="UPGRADE" then return false end
        priority="FRONT ANTI-AIR ROUTINE"
    elseif focus=="FRONT AIR" then
        c=S.frontAirUpgradeChoice(choices,budget,os.clock(),true)
        priority="FRONT ANTI-AIR"
    elseif focus=="COMBAT" or focus=="CARRY" then
        local threat=S.priorityThreat
        local danger=focus=="COMBAT" and S.tactical and S.tactical.danger
        if danger and threat then
            for _,candidate in choices do
                candidate.intercepts=false
                candidate.canStop=false
                if not S.isDirectCombatId(val(candidate.stats,"id")) then continue end
                local radius=candidate.nextRange or tonumber(val(candidate.stats,"range")) or 0
                for _,sample in threat.path.samples do
                    if sample.s>=threat.progress and flat(sample.p,candidate.position)<=radius
                        and math.abs(sample.p.Y-candidate.position.Y)<=radius+3 then
                        candidate.intercepts=true
                        if not S.emergencyUpgradeEligible(candidate,threat) then
                            candidate.intercepts=false break
                        end
                        local hp=tonumber(val(threat.enemy:FindFirstChild("_stats"),"health")) or math.huge
                        local speed=math.max(tonumber(val(threat.enemy:FindFirstChild("_stats"),"speed")) or 4,1)
                        local remaining=pathCoverage(candidate.position,radius,threat.path,threat.progress,threat.path.length)
                        candidate.canStop=(candidate.nextAttack or candidate.attack)/math.max(candidate.nextInterval or 1,0.1)*remaining/speed>=hp
                        break
                    end
                end
            end
        end
        if not danger then
            local air,action,cost=S.routineFrontAirDecision(choices,budget,os.clock())
            if action=="UPGRADE" then
                c=air
            elseif action=="SAVE" or action=="WAIT" then
                S.upgradePriority="FRONT ANTI-AIR ROUTINE"
                status.Text="Front anti-air upgrade queued | cost "..cost
                -- Preserve the existing affordable-farm fallback for optional CARRY attempts.
                return focus~="CARRY"
            end
            local locked=not c and lockedFrontCandidate(choices,S.frontMaxTarget)
            if locked then
                S.frontMaxTarget=locked.unit
                if locked.cost<=budget and os.clock()>=(locked.readyAt or 0) then c=locked
                else
                    if locked.cost<=budget then return false end
                    S.upgradePriority="MAX ONE FRONT UNIT"
                    status.Text="Maxing "..locked.unit.Name.." first | next upgrade "..locked.cost
                    S.deferredCarry={unit=locked.unit.Name,cost=locked.cost,budget=budget,focus=focus}
                    -- CARRY is an optional attempt after defense is confirmed sufficient.
                    -- It must not report success and swallow the affordable farm fallback.
                    if focus=="CARRY" then return false end
                    return true
                end
            else S.frontMaxTarget=nil end
        end
        if danger then
            local effective={}
            for _,candidate in choices do if candidate.intercepts and candidate.canStop then effective[#effective+1]=candidate end end
            c=pickFinalUpgrade(effective,budget,os.clock())
            if not c and S.allowSupportUpgrade then c=pickCombatUpgrade(choices,budget,os.clock(),true) end
        elseif not c then
            c=S.frontAirUpgradeChoice(choices,budget,os.clock(),false)
            if not c then c=pickCombatUpgrade(choices,budget,os.clock(),false) end
        end
        priority=danger and "THREAT INTERCEPT" or "MAX ONE FRONT UNIT"
    elseif focus=="FARM" then
        c=S.pickFarmIncomeUpgrade(choices,budget,os.clock())
        priority="FARM INCOME / COST"
    else c,priority=pickUpgrade(choices,budget,os.clock()) end
    if focus=="FARM" then priority="FARM" elseif focus=="FINAL" then priority="FINAL STRONGEST" end
    S.upgradePriority=priority
    if not c then
        if #choices>0 then status.Text="Saving for "..priority.." upgrade | available "..math.floor(budget) end
        return false
    end
    if not S.enabled or S.generation~=generation then return false end
    S.deferredCarry=nil
    S.upgradeCooldown[c.unit]=os.clock()+5
    status.Text="Upgrading "..priority.." "..c.unit.Name.." | cost "..c.cost
    S.lastUpgrade={name=c.unit.Name,role=priority,before=c.level,cost=c.cost}
    local cashBefore=tonumber(val(P:FindFirstChild("_stats"),"resource")) or 0
    local requestStarted=os.clock()
    local sent,sendError=pcall(function() return getgenv().AAInvokeConnected(upgradeRemote,c.unit) end)
    S.lastUpgrade.requestMs=(os.clock()-requestStarted)*1000
    if not sent then
        S.upgradeCooldown[c.unit]=os.clock()+1.5
        S.lastUpgrade.error=tostring(sendError):sub(1,160)
        status.Text="Upgrade retry: "..S.lastUpgrade.error
        return false
    end
