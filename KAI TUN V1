    if why:find("cap") or why:find("limit") or why:find("maximum") or why:find("max units",1,true) then return "CAP" end
    if why:find("cooldown") or why:find("too fast",1,true) or why:find("slow down",1,true) then return "COOLDOWN" end
    if why:find("money") or why:find("resource") or why:find("afford") then return "FUNDS" end
