    end
    local function tickStarter()
        S.reconcileStarterProgress()
        if not S.alive or state.done or not Loader.IsLobby then return end
        S.reconcileStarterProgress()
        if state.phase=="FIRST_REWARDS" then
            if completedCount(state.firstStage or "namek_level_6")>0 then transition("RESULTS_CONFIRMED")
            else S.starterSummonBlocking=true S.starterSummonStatus="Waiting for confirmed Story completion; navigation locked" return end
        end
        if state.phase=="CLAIM_STORY" then
            S.starterSummonBlocking=true E.AAStarterSummonBusy=true
            if not S.claimStarterStory() then return end
        end
        if state.phase=="REBUILD_TEAM" then
            S.starterSummonBlocking=true E.AAStarterSummonBusy=true
            S.autoTeam=true
            if not S.enabled then S.setEnabled(true) end
            local plan=chooseInventoryTeam()
            if not plan or not plan.primary or #plan.team<2 then S.starterSummonStatus="Waiting for a usable new team; navigation remains OFF" return end
            if not equipInventoryTeam(plan) then S.starterSummonStatus="New team not confirmed by game; navigation remains OFF" return end
            state.teamConfirmedAt=os.time() state.teamCount=#plan.team
            transition("TEAM_CONFIRMED")
            S.autoArcSkip=true S.questFarm=state.resumeQuest==true
            S.autoNext=state.resumeNext~=false S.autoRetry=false
            state.navigationPaused=false saveStarter() S.saveSettings() S.syncControls()
            S.starterSummonBlocking=false E.AAStarterSummonBusy=false
            S.wakeLobby("New team confirmed; entering Titan World Skip")
            return
        end
        if state.phase=="FIRST_RUN" or state.phase=="SECOND_RUN" then
            S.starterSummonBlocking=false E.AAStarterSummonBusy=false
            if state.navigationPaused or not S.autoArcSkip then
                if not S.confirmBestTeamAfterSummon() then
                    S.starterSummonStatus="Waiting for confirmed starter team before resuming lobby navigation"
                    return
                end
                state.navigationPaused=false S.autoArcSkip=true
                S.autoNext=state.resumeNext~=false S.autoRetry=false
                S.questFarm=state.resumeQuest==true
                saveStarter() S.saveSettings() S.syncControls()
            end
