        end
        local ss=session() local stats=P:FindFirstChild("_stats") local gems=stats and stats:FindFirstChild("gem_amount")
        local profile=ss and ss.collection and ss.collection.collection_profile_data
        if not game:IsLoaded() or not gems or type(profile)~="table" or type(profile.owned_units)~="table" then return end
        local balance=tonumber(gems.Value) if not balance then return end
        local levelData=ss.profile_data and ss.profile_data.level_data
        if type(levelData)~="table" or type(levelData.completed_story_levels)~="table" then
            S.starterSummonStatus="Waiting for loaded Story progress before starter eligibility check" return
        end
        local qualified=S.starterSummonEligible(profile,true,{done=false,active=false},ss.profile_data.level_data)
        if qualified then emptySamples+=1 else emptySamples=0 end
        local settled=emptySamples>=3 and os.clock()-startedAt>=5
        local eligible=S.starterSummonEligible(profile,settled,state,ss.profile_data.level_data)
        if not state.active and os.clock()-startedAt<5 then return end
        if qualified and not settled then return end
        if not eligible then S.starterEligibilityResolved=true return end
        -- Keep navigation gated until the eligible account has entered its setup state.

        local dex=E.AASummonDex
        if dex and dex.alive and dex.running then return end
        local callback=cachedLookup("function",{Constants={"buy_from_banner"}},true)
        local env=callback and getfenv(callback)
        local native=env and env.GUIService local banners=env and env.Banners local prices=env and env.SummonServiceCore
        if not native or not banners or not prices or not env.SummonServiceClient or not env.SummonServiceClient.BANNER_UNITS then
            S.starterSummonStatus="Waiting for live Summon services" return
        end
        if not state.active then
            state.started=os.time() state.round=1
            transition("QUALIFIED")
        end
        S.starterEligibilityResolved=true
        if state.phase~="INITIAL_SUMMON" and state.phase~="SECOND_SUMMON" then return end
        if os.clock()-startedAt<5 then return end
        S.starterSummonBlocking=true E.AAStarterSummonBusy=true
        -- A pending debit is never sent twice, even after a reconnect.
        if state.pending then
            local p=state.pending
            local decision,info=E.AALiveAuditModules.purchaseEvidence(p,{
                balance=balance,owned=profile.owned_units,
                exclusivePurchaseId=E.AASummonPurchaseOwner==p.id and p.id or nil})
            S.starterPurchaseEvidence=decision
            if decision=="CONFIRMED" then
                state.pulls=(state.pulls or 0)+info.pulls state.spent=(state.spent or 0)+info.spent
                state.pending=nil E.AASummonPurchaseOwner=nil saveStarter()
            else
