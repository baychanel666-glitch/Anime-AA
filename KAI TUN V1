local function lastCoveredProgress(position,range,path)
    local last
    for _,seg in path.segments do
        local v=Vector2.new(seg.b.X-seg.a.X,seg.b.Z-seg.a.Z)
        local q=Vector2.new(position.X-seg.a.X,position.Z-seg.a.Z)
        local length2=v:Dot(v)
        if length2>0 then
            local center=q:Dot(v)/length2
            local perpendicular=math.max(0,q:Dot(q)-q:Dot(v)^2/length2)
            if perpendicular<=range*range then
                local half=math.sqrt(math.max(0,(range*range-perpendicular)/length2))
                local lo,hi=math.max(0,center-half),math.min(1,center+half)
                if lo<=hi then last=math.max(last or 0,seg.start+hi*seg.length) end
            end
        end
    end
    return last
end
function S.isAutoSellProtectedId(id)
    -- Elyssia keeps contributing through summoned attackers after enemies pass her own range.
    local d=defs[id]
    return type(id)=="string" and (id=="elyssia" or id:match("^elyssia_")~=nil
        or d and d._show_as_buff_unit==true)
end
local function passedFinalCoverage(unit,ps,enemies)
    if S.isAutoSellProtectedId(val(unit.stats,"id")) then return false end
    if #enemies==0 then return false end
    local range=tonumber(val(unit.stats,"range")) or 0
    if range<=0 then return false end
    local relevant=false
    for _,enemy in enemies do
        if flat(unit.p,enemy.p)<=range+1 then return false end
        if not enemy.path then return false end
    end
    for _,path in ps do
        local last=lastCoveredProgress(unit.p,range+1,path)
        if last then
            relevant=true
            local found=false
            for _,enemy in enemies do if enemy.path==path then
                found=true
                if enemy.progress<=last+1 then return false end
            end end
            -- An empty lane provides no evidence that its final monsters have passed.
            if not found then return false end
        end
    end
    return relevant
end
