        end
        for uuid,q in pairs(ss.profile_data.quest_handler and ss.profile_data.quest_handler.quests or {}) do
            local info=q.quest_info local goal=info and info.quest_class
            if q.quest_type=="story" and goal and goal.class=="finish_level" and levels[goal.level_id]
                and levels[goal.level_id].world==state.firstWorld and (q.quest_progress and q.quest_progress.amount or 0)>=(goal.amount or math.huge) then
                if os.time()-(state.claimAttempts[uuid] or 0)>=8 then
                    state.claimAttempts[uuid]=os.time() saveStarter() invoke("redeem_quest",uuid)
                end
                S.starterSummonStatus="Claiming completed Story quest before summoning"
                return false
            end
        end
        local check=cachedLookup("function",{Name="check_if_unlocked_level"},true)
        if not check or not check(ss.profile_data.level_data,"aot_level_1") then
            S.starterSummonStatus="Walled City still locked by game; no summoning/queue until Story progress confirmed"
            return false
