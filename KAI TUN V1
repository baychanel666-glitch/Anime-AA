local function bindDrag(handle,target)
    handle.Active=true
    local function screenPosition()
        local root=target:FindFirstAncestorWhichIsA("ScreenGui")
        return target.AbsolutePosition-(root and root.AbsolutePosition or Vector2.zero)
    end
    local function parentScale()
        local scale=1 local parent=target.Parent
        while parent and parent:IsA("GuiObject") do
            local uiScale=parent:FindFirstChildOfClass("UIScale")
            if uiScale then scale*=uiScale.Scale end
            parent=parent.Parent
        end
        return math.max(scale,0.001)
    end
    if not target:GetAttribute("DragFitBound") then
        target:SetAttribute("DragFitBound",true)
        local fitScale=target:FindFirstChildOfClass("UIScale") or Instance.new("UIScale",target)
        fitScale.Name="ResponsiveWindowScale"
        local function fit()
            if not target.Parent or not workspace.CurrentCamera then return end
            local view=workspace.CurrentCamera.ViewportSize local ps=parentScale()
            local width=target.Size.X.Offset*ps local height=target.Size.Y.Offset*ps
            if width>0 and height>0 then fitScale.Scale=math.max(0.05,math.min(1,(view.X-12)/width,(view.Y-12)/height)) end
            task.defer(function()
                task.wait()
                if not target.Parent then return end
                local abs=screenPosition()
                local nextPosition=S.clampUiPosition(abs,target.AbsoluteSize,workspace.CurrentCamera.ViewportSize)
                local delta=nextPosition-abs local pos=target.Position local effectiveScale=parentScale()
                target.Position=UDim2.new(pos.X.Scale,pos.X.Offset+delta.X/effectiveScale,pos.Y.Scale,pos.Y.Offset+delta.Y/effectiveScale)
            end)
        end
        track(target:GetPropertyChangedSignal("Size"):Connect(fit))
        track(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit))
        fit()
    end
    local active,start,startPosition,startAbsolute,dragScale
    track(handle.InputBegan:Connect(function(input)
        if active then return end
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            active=input start=input.Position startPosition=target.Position startAbsolute=screenPosition() dragScale=parentScale()
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if not active or not target.Parent then return end
        if input~=active and not (active.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement) then return end
        local delta=input.Position-start
        if Vector2.new(delta.X,delta.Y).Magnitude<6 then return end
        target:SetAttribute("LastDragAt",os.clock())
        local view=workspace.CurrentCamera.ViewportSize
        local position=S.clampUiPosition(startAbsolute+Vector2.new(delta.X,delta.Y),target.AbsoluteSize,view)
        local movement=(position-startAbsolute)/dragScale
        target.Position=UDim2.new(startPosition.X.Scale,startPosition.X.Offset+movement.X,startPosition.Y.Scale,startPosition.Y.Offset+movement.Y)
    end))
    track(UIS.InputEnded:Connect(function(input)
        if input==active then active=nil end
    end))
end
