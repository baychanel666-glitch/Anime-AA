local function existingDefense(threat)
    if not threat or not threat.enemy or not threat.enemy.Parent then return false,0,0 end
    local enemy=threat.enemy local stats=enemy:FindFirstChild("_stats")
    local health=tonumber(val(stats,"health")) or math.huge
    local speed=math.max(tonumber(val(stats,"speed")) or 4,1)
    local air=enemyIsAir(enemy)
    local canAir=cachedLookup("function",{Name="unit_can_target_air"},true)
    local capacity,count=0,0
    for _,u in ownUnits() do
        local d=defs[val(u.stats,"id")] or {}
        local damage=tonumber(val(u.stats,"damage")) or 0
        local range=tonumber(val(u.stats,"range")) or 0
        -- Elyssia's spawned attackers are already in ownUnits; count their actual coverage once.
        if S.isDirectCombatId(val(u.stats,"id")) and damage>0 and (not air or (safeCanTargetAir(canAir,u.unit)))
            and matchup({def=d,attack=damage},enemy).immune>0 then
            local coverage=pathCoverage(u.p,range,threat.path,threat.progress,threat.path.length)
            if coverage>0 then
                count+=1
                local cd=math.max(tonumber(val(u.stats,"attack_cooldown")) or d.attack_cooldown or 1,0.1)
                local competing=0
                local reach=lastCoveredProgress(u.p,range,threat.path)
                for _,other in S.enemyPressure or {} do
                    if other.path==threat.path and other.unit.Parent and reach and other.progress<=reach
                        and (not enemyIsAir(other.unit) or safeCanTargetAir(canAir,u.unit))
                        and matchup({def=d,attack=damage},other.unit).immune>0 then competing+=1 end
                end
                -- Conservative shared attack budget: never count the full DPS separately for every enemy.
                capacity+=damage/cd*math.max(0,coverage/speed-cd*0.5)/math.max(competing,1)
            end
        end
    end
    local required=health*1.15
    return capacity>=required,count,capacity
end
local function finalRearReinforcement(ps,enemies,cash,generation)
    table.sort(enemies,function(a,b) return (a.progress or 0)/math.max(a.path and a.path.length or 1,1)>(b.progress or 0)/math.max(b.path and b.path.length or 1,1) end)
    local owned=ownUnits()
    local competitionCache={}
    local canAir=cachedLookup("function",{Name="unit_can_target_air"},true)
    for _,enemy in enemies do if enemy.path and enemy.unit and enemy.unit.Parent then
        local air=enemyIsAir(enemy.unit)
        local capacity=0
        local enemyStats=enemy.unit:FindFirstChild("_stats")
        local speed=math.max(tonumber(val(enemyStats,"speed")) or 4,1)
        local health=tonumber(val(enemyStats,"health")) or math.huge
        for _,u in owned do
            if not isFarm(u) and not S.finalRetired[u.unit] then
                local def=defs[val(u.stats,"id")] or {}
                local unit={def=def,attack=tonumber(val(u.stats,"damage")) or 0}
                local airOK=not air or (safeCanTargetAir(canAir,u.unit))
                local reach=lastCoveredProgress(u.p,tonumber(val(u.stats,"range")) or 0,enemy.path)
                if airOK and S.isDirectCombatId(val(u.stats,"id")) and unit.attack>0 and matchup(unit,enemy.unit).immune>0 and reach and reach>enemy.progress+2 then
                    local range=tonumber(val(u.stats,"range")) or 0
                    local coverage=pathCoverage(u.p,range,enemy.path,enemy.progress,enemy.path.length)
                    local interval=math.max(tonumber(val(u.stats,"attack_cooldown")) or def.attack_cooldown or 1,0.1)
                    -- Share each unit's available damage among competing targets in its remaining coverage.
                    local competitionKey=u.unit
                    local laneCounts=competitionCache[competitionKey]
                    if not laneCounts then laneCounts={} competitionCache[competitionKey]=laneCounts end
                    local competing=laneCounts[enemy.path]
                    if not competing then
                    competing=0
                    for _,other in enemies do
                        if other.path==enemy.path and other.progress<=reach and other.unit and other.unit.Parent
                            and (not enemyIsAir(other.unit) or (safeCanTargetAir(canAir,u.unit)))
                            and matchup(unit,other.unit).immune>0 then competing+=1 end
                    end
                    laneCounts[enemy.path]=math.max(competing,1)
                    end
                    capacity+=unit.attack/interval*math.max(0,coverage/speed-interval*0.5)/math.max(competing,1)

                end
            end
        end
        local supported=capacity>=health*1.25
        S.rearCapacity={enemy=val(enemyStats,"id"),air=air,health=health,estimatedDamage=capacity,required=health*1.25,sufficient=supported}
        if not supported then
            local enough,reachable=existingDefense({enemy=enemy.unit,path=enemy.path,progress=enemy.progress})
            if enough then continue end
            if reachable>0 then
                for _,u in owned do if not S.finalRetired[u.unit] and not isFarm(u) then
                    local range=tonumber(val(u.stats,"range")) or 0
                    local coverage=pathCoverage(u.p,range,enemy.path,enemy.progress,enemy.path.length)
                    if coverage>0 and (not air or (safeCanTargetAir(canAir,u.unit))) then S.finalSupportTarget=u.unit break end
                end end
                if upgrade(cash,generation,"FINAL") then return true end
            end
            if os.clock()-(S.lastRearPlacedAt or -math.huge)<3 and enemy.progress/enemy.path.length<0.85 then continue end
            local options=readyToPlace(team(),cash,0,os.clock(),S.spawnCooldown)
            local suitable={}
            for _,u in options do
                if (not air or baseHitsAir(u)) and matchup(u,enemy.unit).immune>0 then suitable[#suitable+1]=u end
            end
            local selected=selectCounter(suitable,enemy.unit)
            if selected then
                S.preferBestFront=false S.fastFarmOpening=false
                local speed=math.max(tonumber(val(enemy.unit:FindFirstChild("_stats"),"speed")) or 4,1)
                local anchor={path=enemy.path,progress=math.min(enemy.path.length-1,enemy.progress+speed*1.5),unit=enemy.unit}
                local p=plan(selected,ps,{anchor},nil)
                if p and S.enabled and S.generation==generation and enemy.unit.Parent then
                    local nowProgress=project(enemy.unit:GetPivot().Position,enemy.path)
                    local last=lastCoveredProgress(p.position,selected.range,enemy.path)
                    if not last or last<=nowProgress+speed then return false end
                    local before={} for _,u in ownUnits() do before[u.unit]=true end
                    S.spawnCooldown[selected.uuid]=os.clock()+math.max(1,tonumber(selected.def.cooldown) or 10)
                    status.Text="Final rear "..(air and "ANTI-AIR" or "COUNTER")..": "..selected.id
                    local ok,reply=pcall(function() return getgenv().AAInvokeConnected(remote,selected.uuid,CFrame.new(p.position)) end)
                    local deadline=os.clock()+1.5 local placed
                    repeat
                        if not S.alive or S.generation~=generation then return true end
                        for _,u in ownUnits() do if not before[u.unit] and val(u.stats,"uuid")==selected.uuid then placed=u.unit break end end
                        if placed then break end task.wait(0.05)
                    until os.clock()>=deadline
                    S.lastRearReinforcement={id=selected.id,air=air,confirmed=placed~=nil,reply=tostring(reply),ok=ok}
                    if placed then S.lastRearPlacedAt=os.clock() S.placementRoles[placed]="REAR" S.finalSupportTarget=placed S.confirmed+=1
                    else S.badPoints[p.key]=os.clock()+15 S.skips[selected.uuid]=os.clock()+1 end
                    return true
                end
            end
            S.rearDefenseWait=air and "No affordable ready Hill/Hybrid counter or legal hill ahead" or "No affordable ready counter or legal interception point"
        end
    end end
    return false
end
