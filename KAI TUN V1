function S.summonLimitState(watch)
    if watch.pendingPurchase then return "PENDING_PURCHASE" end
    if watch.untilGemsEmpty==true then return "UNLIMITED" end
    local budget,maxPulls=tonumber(watch.budget),tonumber(watch.maxPulls)
    local spent,pulls=tonumber(watch.spent or 0),tonumber(watch.pulls or 0)
    if not budget or not maxPulls or not spent or not pulls or budget~=budget or maxPulls~=maxPulls
        or spent~=spent or pulls~=pulls or budget==math.huge or maxPulls==math.huge
        or budget<0 or maxPulls<0 or spent<0 or pulls<0 or maxPulls%1~=0 or pulls%1~=0 then return "INVALID_LIMITS" end
    if pulls>=maxPulls or spent>=budget then return "LIMIT_REACHED" end
