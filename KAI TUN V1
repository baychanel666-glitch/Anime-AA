    if not pending then return end
    E.AAStoppedPurchaseJobs=E.AAStoppedPurchaseJobs or {}
    local key=tostring(P.UserId)..":"..tostring(pending.id)
    if E.AAStoppedPurchaseJobs[key] then return end
    E.AAStoppedPurchaseJobs[key]=true
    local settle=E.AALiveAuditModules.stoppedSettlement({pending=pending,userId=P.UserId,
        load=E.AAReadSummonWatch,save=E.AAWriteSummonWatch,evidence=E.AALiveAuditModules.purchaseEvidence,
        snapshot=function()
            local ss=Loader.load_client_service(script,"UnitCollectionServiceClient").session
            local profile=ss and ss.collection and ss.collection.collection_profile_data
            local _,_,balance=price(pending.banner)
            return {owned=profile and profile.owned_units,balance=balance,
                exclusivePurchaseId=E.AASummonPurchaseOwner==pending.id and pending.id or nil}
        end})
    task.defer(function()
        local ok,err=pcall(function()
            local deadline=os.clock()+20
            repeat
                if not E.AAConnectionGuard.check(true) then S.purchaseEvidence="DISCONNECTED" return end
                local decision,watch=settle() S.purchaseEvidence=decision
                if decision=="CONFIRMED" then
                    S.pendingPurchase=nil S.pulls=watch.pulls S.spent=watch.spent
                    S.confirmedPulls=watch.confirmedPulls S.currencySpent=watch.currencySpent
                    if E.AASummonPurchaseOwner==pending.id then E.AASummonPurchaseOwner=nil end
                    if S.alive then refreshStats() S.status.Text="Already sent purchase confirmed; no further requests" end
                    local resume=S.pendingResumeRequested S.pendingResumeRequested=nil
                    if resume then resumeStoppedWatch() end
                    return
                end
                if decision=="FOREIGN_OR_MISSING_JOURNAL" or decision=="SUPERSEDED" or decision=="CORRUPT_COUNTERS" or decision=="INVALID_EVIDENCE" then return end
                task.wait(0.2)
            until os.clock()>=deadline
        end)
        if not ok then S.purchaseEvidence="SETTLEMENT_ERROR: "..tostring(err):sub(1,150) end
        E.AAStoppedPurchaseJobs[key]=nil
    end)
end
