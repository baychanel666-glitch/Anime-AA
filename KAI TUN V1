function S.autoDevelopmentTick()
    if S.starterEligibilityResolved==false then return end
    if not S.instanceGuard or S.teamEquipBusy or S.starterSummonBlocking or S.summonBlocking
        or S.summonRewardsPending or S.summonExitPending then return end
    local dex=E.AASummonDex
    if dex and dex.alive and dex.running then return end
    if not Loader.IsLobby or not (S.autoFeedSelected or S.autoFuseSelected or S.autoBestDevelopment) or S.developmentBusy then return end
    local ss=session() if not ss then return end
    local profile=ss.collection.collection_profile_data local selected=S.selectedDevelopmentTargets()
    if S.autoBestDevelopment then
        local best=S.bestDevelopmentTarget() selected={}
        if best then selected[best.uuid]=true S.autoBestTarget=best end
    end
    local levelFn=cachedLookup("function",{Name="calculate_level",Constants={"log","floor"}},true)
    if not levelFn then return end
    local settings=getfenv(levelFn).GameplaySettings
    local cap=settings and settings.UNIT_LEVEL_CAP
    if not cap then S.autoDevelopmentStatus="Waiting for game level cap" return end
    local recipients={} local count=0
    for uuid,on in pairs(selected) do
        local o=profile.owned_units[uuid] local d=o and defs[o.unit_id]
        if on and d and (d.damage or 0)>0 and not S.isDevelopmentFarm(d) then
            count+=1
            local level=levelFn(o.unit_id,o.xp or 0)
            if level<cap then recipients[#recipients+1]={uuid=uuid,own=o,level=level,damage=d.damage or 0} end
        end
    end
    if #recipients==0 then S.autoDevelopmentStatus=count>0 and "All selected targets at max level; auto stays ON" or "Select one or more damage units" return end
    table.sort(recipients,function(a,b)
        if a.level~=b.level then return a.level<b.level end
        local ac=S.developmentTurns and S.developmentTurns[a.uuid] or 0 local bc=S.developmentTurns and S.developmentTurns[b.uuid] or 0
        if ac~=bc then return ac<bc end
        if a.damage~=b.damage then return a.damage>b.damage end return a.uuid<b.uuid
    end)
    local target=recipients[1]
    if S.isDevelopmentFarm(defs[target.own.unit_id]) then S.autoDevelopmentStatus="Farm target blocked" return end
    local request local material local itemCount=0
    -- Alternate food and unit fusion when both are available.
    local function foodRequest()
        if not (S.autoFeedSelected or S.autoBestDevelopment) then return end
        local f=cachedLookup("function",{Constants={"LevelUpFeed"}},true) local util=f and getfenv(f).LevelUtil
        local allowed=false for _,id in pairs(util and util.xp_items or {}) do if id==S.feedItem then allowed=true end end
        if not allowed then return end
        itemCount=ss.inventory:get_number_of_owned_item(S.feedItem)
        if itemCount>0 then
            local id=S.feedItem material="EXP "..id
            request=function() return invoke("level_up_feed",target.uuid,{[id]=1}) end
        end
    end
    local function fuseRequest()
        if not (S.autoFuseSelected or S.autoBestDevelopment) then return end
        local equipped={} for _,uuid in pairs(profile.equipped_units) do equipped[uuid]=true end
        local wanted={} local plan=chooseInventoryTeam() for _,row in ipairs(plan and plan.team or {}) do wanted[row.uuid]=true end
        local rarities={} for rarity in (S.fuseRarities or ""):gmatch("[^,]+") do rarities[rarity]=true end
        local donors={}
        for uuid,o in pairs(profile.owned_units) do
            local d=defs[o.unit_id]
            if d and rarities[d.rarity] and not selected[uuid] and not equipped[uuid] and not wanted[uuid]
                and not o._locked and not o.locked and not o.favorite and not o.favorited and not o._favorite
                and not o.shiny and not o._equipped_relic and not S.isDevelopmentFarm(d) then
                donors[#donors+1]={uuid=uuid,xp=o.xp or 0,name=d.name or o.unit_id}
            end
        end
        table.sort(donors,function(a,b) if a.xp==b.xp then return a.uuid<b.uuid end return a.xp<b.xp end)
        if donors[1] then
            local gainFn=cachedLookup("function",{Name="calculate_xp_gain_from_fuse"},true)
            local xpFn=cachedLookup("function",{Name="calculate_xp",Constants={"pow"}},true)
            local desiredLevel=#recipients>1 and math.min(cap,math.max(target.level+1,recipients[2].level)) or cap
            local desiredXP=xpFn and xpFn(target.own.unit_id,desiredLevel)
            local need=desiredXP and math.max(0,desiredXP-(target.own.xp or 0))
            local ids,ownedBatch={},{}
            for _,donor in ipairs(donors) do
                ids[#ids+1]=donor.uuid ownedBatch[#ownedBatch+1]=profile.owned_units[donor.uuid]
                if #ids>=50 then break end
                if gainFn and need then
                    local ok,gain=pcall(gainFn,target.own,ownedBatch,ss)
                    if not ok or type(gain)~="number" or gain>=need then break end
                else break end
            end
            material="FUSE BATCH "..#ids.." units"
            S.lastFuseBatch={target=target.uuid,count=#ids,desiredLevel=desiredLevel}
            request=function() return invoke("feed_units",target.uuid,ids) end
        end
    end
    if S.lastDevelopmentKind=="FOOD" then fuseRequest() if not request then foodRequest() end
    else foodRequest() if not request then fuseRequest() end end
    if not request then S.autoDevelopmentStatus="Waiting for selected EXP item / eligible donors; auto stays ON" return end
    local inventoryCount=0 for _ in pairs(profile.owned_units) do inventoryCount+=1 end
    local fingerprint=target.uuid..":"..tostring(target.own.xp)
    if S.developmentAutoBlocked==fingerprint then S.autoDevelopmentStatus="Result unconfirmed; waiting for inventory change (auto remains ON)" return end
    S.developmentBusy=true
    local before=target.own.xp or 0
    S.autoDevelopmentStatus=material.." -> "..(defs[target.own.unit_id].name or target.own.unit_id)
    local ok,reply=pcall(request)
    local deadline=os.clock()+3
    local function currentXP()
        local latest=session()
        local collection=latest and latest.collection and latest.collection.collection_profile_data
        local own=collection and collection.owned_units and collection.owned_units[target.uuid]
        return own and tonumber(own.xp) or before
    end
    while S.alive and ok and currentXP()<=before and os.clock()<deadline do task.wait(0.1) end
    S.developmentBusy=false
    local confirmed=currentXP()>before
    if not confirmed then
        S.developmentAutoBlocked=fingerprint
        S.autoDevelopmentStatus="XP unconfirmed; no automatic repeat of this request"
    else
        S.developmentTurns=S.developmentTurns or {} S.developmentTurns[target.uuid]=(S.developmentTurns[target.uuid] or 0)+1
        S.lastDevelopmentKind=material:sub(1,3)=="EXP" and "FOOD" or "FUSE"
        S.autoDevelopmentStatus="Confirmed "..material.." -> "..(defs[target.own.unit_id].name or target.own.unit_id)
    end
    S.lastSelectedDevelopment={uuid=target.uuid,before=before,after=target.own.xp,confirmed=confirmed,ok=ok,reply=tostring(reply)}
end
end

