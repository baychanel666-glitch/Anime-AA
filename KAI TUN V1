                S.starterDefeatReadyAt=S.starterDefeatReadyAt or os.clock()
                if os.clock()-S.starterDefeatReadyAt<10 then
                    S.starterSummonStatus="Defeat confirmed; waiting for reward/save before fallback"
                    return
                end
                local patch=E.AALiveAuditModules.firstDefeat(state,{confirmed=true,victory=false,
                    job=game.JobId,world=ld.world,stage=ld.id})
                if patch then
                    state.firstSkipLost=patch.firstSkipLost state.firstSkipLostJob=patch.firstSkipLostJob
                    state.navigationPaused=patch.navigationPaused
                    S.autoArcSkip=patch.autoArcSkip S.questFarm=patch.questFarm
                    S.autoNext=patch.autoNext S.autoRetry=false
                    if state.resumeReserve~=nil then S.reserve=state.resumeReserve end
                    S.starterSummonBlocking=false E.AAStarterSummonBusy=false
                    saveStarter() S.saveSettings() S.syncControls()
                end
