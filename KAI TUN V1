    end end
    S.finalWaveState={remainingFarms=remaining,unsellable=unsellable,sold=S.farmsSold or 0,attackersSold=S.passedUnitsSold or 0,enemies=#enemies}
    local cash=tonumber(val(P:FindFirstChild("_stats"),"resource")) or 0
