local function tacticalState(leaks)
    local own=ownUnits() local enemies=0 local totalHP=0 local closest=0 local dps=0 local defenders=0
    local pathsNow=paths()
    S.priorityThreat=nil
    S.enemyPressure={}
    for _,u in own do
        local d=defs[val(u.stats,"id")] or {}
        if S.isStandingDefender(u) then
            defenders+=1
            dps+=(tonumber(val(u.stats,"damage")) or 0)/math.max(tonumber(val(u.stats,"attack_cooldown")) or 1,0.1)
        end
    end
    local f=workspace:FindFirstChild("_UNITS")
    if f then for _,u in f:GetChildren() do
        local s=u:FindFirstChild("_stats") local b=val(s,"base") local hp=tonumber(val(s,"health")) or 0
        if b and b.Name=="pve" and hp>0 and u:IsA("Model") then
            enemies+=1 totalHP+=hp
            local lane=tostring(val(s,"lane") or "")
            for _,path in pathsNow do if lane=="" or path.lane==lane then
                local progress,dist=project(u:GetPivot().Position,path)
                if dist<12 then S.enemyPressure[#S.enemyPressure+1]={unit=u,path=path,progress=progress,health=hp} end
                if dist<12 and (not S.priorityThreat or progress/path.length>closest) then
                    closest=progress/path.length S.priorityThreat={path=path,progress=progress,enemy=u}
                end
            end end
        end
    end end
    local health=baseHealth()
    local danger,critical=farmRisk(closest)
    local emergency=critical or (health and health<0.5) or false
    local safe=#leaks==0 and defenders>=1 and dps>0 and closest<0.55 and enemies<=math.max(2,defenders)
        and totalHP/math.max(dps,1)<=8 and health~=nil and health>0.75
    return {emergency=emergency,safe=safe,enemies=enemies,health=health,closest=closest,dps=dps,defenders=defenders,totalHP=totalHP,danger=danger,critical=critical}
end
