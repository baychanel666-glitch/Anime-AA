    if S.summonReturnPending and not Loader.IsLobby then
        if rewardTick() then return true end
        if os.clock()<nextSummonWatch then return true end
    end
    if os.clock()<nextSummonWatch then return false end
    nextSummonWatch=os.clock()+5
    local ok,watch=pcall(function()
        local file=getgenv().AAAccountWatchStore.path
        return getgenv().AAReadSummonWatch()
    end)
    if not ok or type(watch)~="table" or not watch.active then S.summonCheckDue=false return false end
    local profile=S.collectionProfile()
    if not profile then return false end
    local targets=type(watch.targets)=="table" and watch.targets or (watch.target and {[watch.target]=true} or {})
    local ownedIds={} for _,o in pairs(profile.owned_units) do ownedIds[o.unit_id]=true end
    local changed=false local pending={}
    for id,on in pairs(targets) do
        if not on or ownedIds[id] then targets[id]=nil changed=true else pending[#pending+1]=id end
    end
    table.sort(pending)
    watch.targets=targets
    if #pending==0 then
        watch.active=false watch.target=nil changed=true
    elseif not targets[watch.target] then watch.target=pending[1] changed=true end
    if changed then assert(getgenv().AAWriteSummonWatch(watch)) end
    if not watch.active then S.summonWatchStatus="All selected targets owned; completed" return false end
    local due=Loader.IsLobby and os.time()>=(tonumber(watch.nextCheck) or 0) or (not Loader.IsLobby and true)
    S.summonCheckDue=due
    if Loader.IsLobby then
        if S.summonLobbyCheckedJob~=game.JobId then
            if not S.prepareSummonLobbyRewards() then S.summonWatchStatus=S.summonRewardStatus return true end
            S.summonLobbyCheckedJob=game.JobId
            due=true watch.nextCheck=0
            assert(getgenv().AAWriteSummonWatch(watch))
        end
        if watch.untilGemsEmpty and watch.waitingGems then
            local balance=tonumber(val(P:FindFirstChild("_stats"),"gem_amount")) or 0
            local callback=cachedLookup("function",{Constants={"buy_from_banner"}},true)
            local env=callback and getfenv(callback)
            local priceCore=env and env.SummonServiceCore
            local ss=session() local minimum
            for _,banner in pairs(require(R.src.Data.Banners)) do
                local base=banner.gem_cost or (banner.resource_cost and banner.resource_cost.id=="gems" and banner.resource_cost.amount)
                if banner.active and base and priceCore and ss then
                    local ok,cost=pcall(priceCore.calculate_hatch_price,ss,base,"gems")
                    if ok and type(cost)=="number" and cost>0 then minimum=math.min(minimum or cost,cost) end
                end
            end
            if not minimum or balance<minimum then
                S.summonCheckDue=false
                S.summonWatchStatus="Summon watch ON; Gems "..balance.." / "..tostring(minimum or "waiting for price")
                return false
            end
            -- Insufficient-Gems is a condition to re-evaluate, never a permanent latch.
            watch.waitingGems=false watch.nextCheck=0 due=true
            S.summonCheckDue=true
            assert(getgenv().AAWriteSummonWatch(watch))
        end
        if not due then
            S.summonWatchStatus="Next banner check in "..math.ceil((watch.nextCheck-os.time())/60).." minutes"
            return false
        end
        local limitState=S.summonLimitState(watch)
        local dex=E.AASummonDex
        if limitState=="PENDING_PURCHASE" or E.AASummonPurchaseOwner or (dex and dex.alive and dex.pendingPurchase) then
            S.summonWatchStatus="Purchase result unconfirmed; no retry or stage entry"
            return true
        end
        if limitState=="LIMIT_REACHED" or limitState=="INVALID_LIMITS" then
            watch.active=false watch.stopReason=limitState
            assert(E.AAWriteSummonWatch(watch))
            if dex and dex.alive then dex.stop(limitState=="LIMIT_REACHED" and "Requested summons completed" or "Set a valid summon count") end
            -- No purchase is pending: the completed watch must not own navigation forever.
            S.summonCheckDue=false
            if S.kaiTunConfigured and not S.kaiTunPaused then S.autoArcSkip=true
            elseif watch.resumeArc~=nil then S.autoArcSkip=watch.resumeArc end
            if watch.resumeQuest~=nil then S.questFarm=watch.resumeQuest end
            S.saveSettings()
            if S.wakeLobby then S.wakeLobby("Summon limit finished; resume progression") end
            S.summonWatchStatus=limitState..": Auto Summon released lobby"
            return false
        end
        if E.AASummonDex and E.AASummonDex.alive and E.AASummonDex.running then
            if not E.AASummonDex.running and E.AASummonDex.rememberBannerReset then
                local time,source=E.AASummonDex.rememberBannerReset()
                S.summonWatchStatus="Banner checked | next reset "..tostring(time).." | "..source
            end
            return true
        end
        -- Reopen once per due check, restoring the saved target and remaining limits.
        if E.AASummonDex and E.AASummonDex.alive then E.AASummonDex.close() end
        -- Close only tears down the UI; restore the active watch before rebuilding it.
        assert(getgenv().AAWriteSummonWatch(watch))
        local fn=loadstring(E.AASummonDexSource)
        if fn then local ok,err=pcall(fn) if not ok then S.summonWatchStatus=tostring(err) end end
        return true
    end
    local data=workspace:FindFirstChild("_DATA")
    if due and val(data,"GameFinished")==true then
        S.summonReturnPending=true
        if rewardTick() then S.summonResultsReadyAt=nil return true end
        local results=pg:FindFirstChild("ResultsUI")
        local finished=results and results:FindFirstChild("Finished")
        if not results or not results.Enabled or not finished or not finished.Visible then
            S.summonWatchStatus="Waiting for confirmed results / reward summary" return true
        end
        S.summonResultsReadyAt=S.summonResultsReadyAt or os.clock()
        if os.clock()-S.summonResultsReadyAt<10 then
            S.summonWatchStatus="Rewards finished; waiting for game save before lobby" return true
        end
        S.summonWatchStatus="Act finished; returning for rewards and banner check"
        S.saveSettings() invoke("teleport_back_to_lobby") return true
    end
    S.summonResultsReadyAt=nil
    S.summonWatchStatus=(Loader.LevelData or {}).infinite and "Auto Summon ON: hourly :01 EST return + check after match rewards" or S.hourlySummonStatus or "Auto Summon ON: lobby checks every hour at :01 EST"
    return false
end
