local hourlyClock=assert(loadstring([=====================================[-- EST is fixed UTC-5. Minute 01 has the same UTC minute at all whole-hour offsets.
local C={offset=-5*3600}
function C.nextAfter(now)
    assert(type(now)=="number" and now==now and now<math.huge and now>=0,"Invalid time")
    return math.floor((now-60)/3600)*3600+3660
end
function C.initial(now)
    local slot=math.floor(now/3600)*3600+60
    if now>=slot and now<slot+60 then return slot end
    return C.nextAfter(now)
end
function C.due(state,now)
    return state.active==true and type(state.nextAt)=="number" and now>=state.nextAt
end
function C.consume(state,now,job,stage)
    local nextAt=C.nextAfter(now)
    return {version=1,userId=state.userId,active=true,nextAt=nextAt,
        lastSlot=state.nextAt,exitJob=job,exitStage=stage,exitAt=now,reason="HOURLY_SUMMON_EST"}
end
return C
]=====================================],"hourly-summon-clock"))()
