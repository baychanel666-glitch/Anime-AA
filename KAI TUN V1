  local function listen(signal,callback) local c=signal:Connect(callback) table.insert(recovery.Connections,c) return c end
  function recovery.IsDisconnect(message,code)
   local text=tostring(message or ''):lower()
   if text:find('banned',1,true) or text:find('suspended',1,true) or text:find('moderation',1,true) or text:find('exploit',1,true) or text:find('cheat',1,true) then return false end
   local value=typeof(code)=='EnumItem' and code.Value or tonumber(code)
   if idleCode and value==idleCode then return true end
   local idle=text:find('idle',1,true) or text:find('inactiv',1,true) or text:find('afk',1,true) or text:find('ไม่ได้ใช้งาน',1,true)
   local disconnected=text:find('disconnect',1,true) or text:find('kick',1,true) or text:find('20 minute',1,true) or text:find('ถูกตัด',1,true)
   if idle~=nil and disconnected~=nil then return true end
   if value==267 or value==277 or value==278 or value==279 then return true end
   return text:find('disconnected',1,true)~=nil or text:find('kicked',1,true)~=nil
    or text:find('lost connection',1,true)~=nil or text:find('ถูกตัดการเชื่อมต่อ',1,true)~=nil

  end
