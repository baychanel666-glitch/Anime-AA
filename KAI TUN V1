-- Compare rarity first, then normalized early/mid/late performance.
function S.unitPotential(uuid,o,ss)
    local d=o and defs[o.unit_id] if not d then return nil end
    S.unitPotentialCache=S.unitPotentialCache or {}
    local signature=o.unit_id..":"..tostring(o.xp)..":"..tostring(o.shiny)..":"..tostring(o.trait)
    local cached=S.unitPotentialCache[uuid]
    if cached and cached.signature==signature and os.clock()<cached.expires then return table.clone(cached.value) end
    local rank=({Secret=6,Mythic=5,Exclusive=5,Legendary=4,Epic=3,Rare=2})[d.rarity] or 1
    local static=cachedLookup("function",{Name="calculate_static_stat_multiplier"},true)
    local xpFn=cachedLookup("function",{Name="calculate_xp",Constants={"pow"}},true)
    local levelFn=cachedLookup("function",{Name="calculate_level",Constants={"log","floor"}},true)
    local cap=levelFn and getfenv(levelFn).GameplaySettings.UNIT_LEVEL_CAP
    local referenceXP=xpFn and cap and xpFn(o.unit_id,cap)
    local function mult(key)
        if not static or not referenceXP then return 1 end
        local ok,value=pcall(static,o,referenceXP,key,ss) return ok and tonumber(value) or 1
    end
    local dm,cd=mult("damage"),mult("attack_cooldown")
    local attacks=require(R.src.Data.Attacks)
    local function aoeWeight(attackId)
        local weight,kind=1,"single/unknown"
        local function scan(t,depth)
            if type(t)~="table" or depth>6 then return end
            local a=t.aoe_type
            if type(a)=="table" then
                local w=1
                if a.type=="full_aoe" then w=3
                elseif a.type=="cone" then w=1.7
                elseif a.type=="straight" then w=1.5
                elseif a.type=="target_aoe_circ" then w=1+math.min(1.5,(tonumber(a.radius) or 0)/4) end
                if w>weight then weight=w kind=a.type end
            end
            for _,v in pairs(t) do if type(v)=="table" then scan(v,depth+1) end end
        end
        scan(attacks[attackId],0) return weight,kind
    end
    local upgrades=type(d.upgrade)=="table" and d.upgrade or {}
    local current={damage=d.damage or 0,cooldown=d.attack_cooldown or 1,range=d.range or 0,cost=d.cost or 0,attack=d.primary_attack_no_upgrades}
    local samples={}
    local function sample()
        local aoe,kind=aoeWeight(current.attack)
        local dps=current.damage*dm/math.max(0.1,current.cooldown*cd)
        local value=dps*(1+math.min(current.range,60)/30)*aoe/math.sqrt(math.max(1,current.cost/500))
        return {score=value,dps=dps,range=current.range,cost=current.cost,aoe=kind,coverageWeight=aoe}
    end
    samples[1]=sample()
    local middle=math.max(1,math.ceil(#upgrades/2))
    for i,stage in ipairs(upgrades) do
        current.damage=stage.damage or current.damage current.cooldown=stage.attack_cooldown or current.cooldown
        current.range=stage.range or current.range current.cost+=(tonumber(stage.cost) or 0)
        current.attack=stage.primary_attack or stage.primary_attack_no_upgrades or current.attack
        if i==middle then samples[2]=sample() end
    end
    samples[2]=samples[2] or samples[1] samples[3]=sample()
    local result={uuid=uuid,id=o.unit_id,rarity=d.rarity,rarityRank=rank,
        potential=samples[1].score*0.30+samples[2].score*0.30+samples[3].score*0.40,
        early=samples[1],mid=samples[2],late=samples[3],referenceLevel=cap,estimated=true}
    S.unitPotentialCache[uuid]={signature=signature,expires=os.clock()+3,value=result}
    return table.clone(result)
end
function S.betterPotential(a,b)
    if not b then return true end
    if a.rarityRank~=b.rarityRank then return a.rarityRank>b.rarityRank end
    if a.potential~=b.potential then return a.potential>b.potential end
    return a.uuid<b.uuid
end

