local function rewardTick()
    if not S.autoRewards then return false end
    local results=pg:FindFirstChild("ResultsUI")
    if not results or not results.Enabled then return false end
    local info=pg:FindFirstChild("UnitInfo")
    local holder=info and info:FindFirstChild("holder")
    local info1=holder and holder:FindFirstChild("info1")
    local skip=info1 and info1:FindFirstChild("SkipLabel")
    if skip and visible(skip) and skip.Text:lower():find("click anywhere to continue",1,true) then
        if S.rewardClickBusy or os.clock()-rewardClickAt<0.35 then return true end
        rewardClickAt=os.clock()
        local functions=cachedLookup("function",{Constants={"infotween_out","MouseButton1","UserInputType"}},false)
        local callback
        for _,fn in ipairs(functions or {}) do
            local connected=false local reward=false
            for _,upvalue in pairs(debug.getupvalues(fn)) do
                if upvalue=="reward" then reward=true end
                if typeof(upvalue)=="RBXScriptConnection" and upvalue.Connected then connected=true end
            end
            if connected and reward then callback=fn break end
        end
        if not callback then status.Text="Reward open; waiting for its click handler" return true end
        S.rewardClickBusy=true
        status.Text="Continuing reward reveal..."
        task.spawn(function()
            -- Call only the live reward callback. Never broadcast InputBegan.
            local ok,err=pcall(callback,{UserInputType=Enum.UserInputType.MouseButton1,
                UserInputState=Enum.UserInputState.Begin,KeyCode=Enum.KeyCode.Unknown,Position=Vector3.zero},false)
            if S.alive then
                S.rewardClickBusy=false
                if ok then S.rewardContinued=(S.rewardContinued or 0)+1
                else status.Text="Reward continue error: "..tostring(err):sub(1,120) end
            end
        end)
        return true
    end
    if S.rewardClickBusy then return true end
    local summary=results:FindFirstChild("Holder")
    local buttons=summary and summary:FindFirstChild("Buttons")
    local nextButton=buttons and buttons:FindFirstChild("Next")
    if visible(nextButton) then
        if os.clock()<(S.rewardNextClickAt or 0) then return true end
        S.rewardNextClickAt=os.clock()+0.5
        if click(nextButton) then
            S.rewardWaitUntil=os.clock()+2
            status.Text="Opened reward reveals from results"
        end
        return true
    end
    local finished=results:FindFirstChild("Finished")
    if finished and finished.Visible then S.rewardWaitUntil=nil return false end
    return os.clock()<(S.rewardWaitUntil or 0)
end

function S.hasSummonTargets()
    local dex=E.AASummonDex
    local watch
    if dex and dex.alive then watch=dex
    else
        local ok,value=pcall(E.AAReadSummonWatch)
        if not ok then return nil end
        watch=value
    end
    if type(watch)~="table" then return false end
    if watch.pendingPurchase then return true end
    if type(watch.targets)=="table" then
        for id,on in pairs(watch.targets) do
            if on==true and type(id)=="string" and id~="" then return true end
        end
        -- An explicit empty multi-target selection overrides a stale legacy target.
        return false
    end
    return type(watch.target)=="string" and watch.target~=""
end
function S.autoSummonEnabled()
    local ok,watch=pcall(E.AAReadSummonWatch)
