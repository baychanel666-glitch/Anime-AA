    function S.recordStarterOutcome(victory,ld)
        if S.hourlyReturnPending then return end
        if S.observeStarterMap then S.observeStarterMap() end
        if not state.active or victory==nil or type(ld)~="table" then return end
        if not Loader.IsLobby then
            local results=pg:FindFirstChild("ResultsUI")
            if not results or not results.Enabled then return end
            local fn=cachedLookup("function",{Constants={"set_game_finished_vote"}},true)
            local env=fn and getfenv(fn) local native=env and env.GUIService and env.GUIService.results_ui
            if not native or not native.settings or native.settings.victory~=victory then return end
        end
        if state.phase=="FIRST_RUN" and ld.world==state.firstWorld and ld.id==state.firstStage then
            if victory then
                state.firstResultJob=game.JobId
                clearFirstReplayCursor()
                transition("FIRST_VICTORY")
                S.starterSummonStatus="First World Skip cleared; one final Gems summon round on lobby return"
            else
                local defeatResults=pg:FindFirstChild("ResultsUI")
                local finished=defeatResults and defeatResults:FindFirstChild("Finished")
                -- Resolve the native result again here; no boss-health or wave-count inference.
                local resultFn=cachedLookup("function",{Constants={"set_game_finished_vote"}},true)
                local resultEnv=resultFn and getfenv(resultFn)
                local nativeResult=resultEnv and resultEnv.GUIService and resultEnv.GUIService.results_ui
                local data=workspace:FindFirstChild("_DATA")
                local gameFinished=data and data:FindFirstChild("GameFinished")
                if Loader.IsLobby or not gameFinished or gameFinished.Value~=true
