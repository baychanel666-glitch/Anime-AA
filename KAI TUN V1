    local h=tonumber(val(s,"health")) local max=tonumber(val(s,"max_health")) or tonumber(val(s,"base_health"))
    if h and max and max>0 then return h/max end
    local waves=pg:FindFirstChild("Waves") local bar=waves and waves:FindFirstChild("HealthBar")
    local text=bar and bar:FindFirstChild("HPDisplay")
    if text then
        local current,total=text.Text:match("([%d%.]+)%s*/%s*([%d%.]+)")
        current,total=tonumber(current),tonumber(total)
        if current and total and total>0 then return current/total end
    end
