        local ok,saved=pcall(function()return isfile(hourlyFile) and game:GetService("HttpService"):JSONDecode(readfile(hourlyFile))end)
        S.hourlySchedule=ok and type(saved)=="table" and saved.userId==P.UserId and saved.version==1
            and type(saved.nextAt)=="number" and saved.nextAt==saved.nextAt and saved.nextAt<math.huge and saved or {version=1,userId=P.UserId,active=false}
    end
    local state=S.hourlySchedule
    if state.exitJob==game.JobId and state.reason=="HOURLY_SUMMON_EST" and now-(state.exitAt or 0)<600 then S.hourlyReturnPending=true end
    local changed=false
    if active and not state.active then state.active=true state.nextAt=hourlyClock.initial(now) changed=true
    elseif not active and state.active then state.active=false state.nextAt=nil changed=true end
    if changed then S.saveHourlySummon(state) end
    if state.active then
        S.hourlySummonNext=state.nextAt
        S.hourlySummonStatus="Next Summon lobby: "..os.date("!%H:%M EST",state.nextAt+hourlyClock.offset)
    end
