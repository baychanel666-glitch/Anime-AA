end
chooseFarm=function(combat,cash,reserveCash)
    if not S.farmEnabled then S.farmState={phase="OFF"} return nil,"NORMAL" end
    local profile=S.collectionProfile()
    if not profile then return nil,"NORMAL" end
    local owned=ownUnits() local inventory={} local options={} local seen={} local capacity=0 local count=0 local upgraded=false
    local speedwagonUUID
    for _,uuid in pairs(profile.equipped_units) do
        if profile.owned_units[uuid] and profile.owned_units[uuid].unit_id=="speedwagon" then speedwagonUUID=uuid break end
    end
    S.speedwagonEquipped=speedwagonUUID~=nil
    local equipped={} for _,uuid in pairs(profile.equipped_units) do equipped[uuid]=true end
    for uuid,o in pairs(profile.owned_units) do
        local d=defs[o.unit_id]
        if d and S.isDevelopmentFarm(d) and (not speedwagonUUID or o.unit_id=="speedwagon") then
            inventory[#inventory+1]={id=o.unit_id,equipped=equipped[uuid]==true}
            if equipped[uuid] then
                if not seen[o.unit_id] then
                    capacity+=math.min(tonumber(d.spawn_cap) or 1,S.caps[uuid] or math.huge)
                    seen[o.unit_id]=true
                end
                local n=0 for _,u in owned do if val(u.stats,"id")==o.unit_id then n+=1 end end
                if n<(tonumber(d.spawn_cap) or 1) and not S.caps[uuid] then
                    options[#options+1]={uuid=uuid,id=o.unit_id,def=d,range=d.range or 5,attack=0,cost=d.cost or math.huge,count=n}
                end
            end
        end
    end
    if S.farmPending then
        local pending=S.farmPending local confirmed=0
        for _,u in owned do if val(u.stats,"uuid")==pending.uuid then confirmed+=1 end end
        if confirmed>pending.before then S.farmPending=nil
        else
            S.farmRecovery={phase="CONFIRMATION",id=pending.id,reason="Resource charged; waiting for actual unit"}
            S.farmState={phase="FIRST FARM",count=confirmed,target=math.max(confirmed+1,1)}
            return nil,"FIRST FARM"
        end
    end
    for _,u in owned do if isFarm(u) and (not speedwagonUUID or val(u.stats,"id")=="speedwagon") then count+=1 if (tonumber(val(u.stats,"upgrade")) or 0)>0 then upgraded=true end end end
    local pending,upgradeAffordable=false,false
    for _,c in upgradeCandidates(true) do
        pending=true if c.cost<=cash and os.clock()>=(c.readyAt or 0) then upgradeAffordable=true end
    end
    local farmAffordable=false for _,u in options do if u.cost<=cash then farmAffordable=true break end end
    local t=S.tactical or {} local wave=workspace:FindFirstChild("_wave_num")
    -- Farm spending follows route progress, not leaks near the front or estimated DPS.
    local pressure,critical=farmRisk(t.closest)
    local target=math.min(3,capacity)
    local state={speedwagon=speedwagonUUID~=nil,count=count,target=target,requested=3,wave=wave and wave.Value or 1,upgraded=upgraded,
        defenders=t.defenders or 0,pendingUpgrade=pending,upgradeAffordable=upgradeAffordable,farmAffordable=farmAffordable,pressure=pressure,critical=critical,progress=t.closest or 0,dangerAt=0.50,criticalAt=0.80,inventory=inventory}
    state.phase=target>0 and farmPhase(state) or "NO EQUIPPED FARM"
    S.farmState=state
    table.sort(options,function(a,b)
        local av=(tonumber(a.def.farm_amount) or 0)/math.max(a.cost,1)
        local bv=(tonumber(b.def.farm_amount) or 0)/math.max(b.cost,1)
        if av~=bv then return av>bv end
        if a.cost~=b.cost then return a.cost<b.cost end
        return a.uuid<b.uuid
    end)
    local selected
    for _,u in options do
        if os.clock()>=(S.spawnCooldown[u.uuid] or 0) and os.clock()>=(S.skips[u.uuid] or 0) then selected=u break end
    end
    return selected,state.phase
end
