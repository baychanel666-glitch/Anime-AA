    local env=getgenv()
    local untilTime=os.clock()+60
    local player
    repeat
        player=game:GetService("Players").LocalPlayer
        if game:IsLoaded() and player and player:FindFirstChild("PlayerGui")
            and game:GetService("ReplicatedStorage"):FindFirstChild("endpoints")
