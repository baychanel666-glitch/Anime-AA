function S.spawnMultipliers(uuid,owned,ss)
    S.spawnStatCache=S.spawnStatCache or {}
    local previous=S.spawnStatCache[uuid]
    if previous and previous.xp==owned.xp and os.clock()<previous.expires then return previous.value end
    local fn=cachedLookup("function",{Name="calculate_static_stat_multiplier"},true)
    local result={damage=1,range=1,cooldown=1}
    if fn and ss then
        for name,key in pairs({damage="damage",range="range",cooldown="attack_cooldown"}) do
            local ok,value=pcall(fn,owned,owned.xp or 0,key,ss)
            if ok and tonumber(value) and value>0 then result[name]=value end
        end
    end
    S.spawnStatCache[uuid]={xp=owned.xp,expires=os.clock()+3,value=result}
    return result
end
local function team()
