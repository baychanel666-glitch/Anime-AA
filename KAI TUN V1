function S.chooseOpeningGuard(units,threat,cash)
    local rows={} local now=os.clock()
    local stats=threat.enemy:FindFirstChild("_stats")
    local speed=math.max(tonumber(val(stats,"speed")) or 4,1)
    local air=enemyIsAir(threat.enemy)
    for _,u in units do
        if S.isDirectCombatId(u.id) and (not air or baseHitsAir(u))
            and matchup(u,threat.enemy).immune>0 and now>=(S.spawnCooldown[u.uuid] or 0) then
            local cd=math.max(u.cooldown or u.def.attack_cooldown or 1,0.1)
            local demand=0
            for _,other in S.enemyPressure or {} do
                if other.path==threat.path and other.unit.Parent and math.abs(other.progress-threat.progress)<=u.range*2
                    and (not enemyIsAir(other.unit) or baseHitsAir(u)) then demand+=other.health or 0 end
            end
            demand=math.max(demand,tonumber(val(stats,"health")) or math.huge)*1.25
            -- Conservative firing window; no free damage credit for future upgrades or unknown AOE.
            local window=math.min(u.range*1.3,math.max(0,threat.path.length-threat.progress))/speed
            local shots=math.max(0,math.floor((window-cd*0.5)/cd))
            rows[#rows+1]={unit=u,ratio=u.attack*shots/math.max(demand,1),damage=u.attack*shots,required=demand}
        end
    end
    local row,reason=S.pickOpeningGuardScored(rows,cash,threat.progress/math.max(threat.path.length,1))
    S.openingGuardDecision={id=row and row.unit.id,reason=reason,coverageRatio=row and row.ratio,
        expectedDamage=row and row.damage,required=row and row.required,cost=row and row.unit.cost,cash=cash}
    return row and row.unit
end
