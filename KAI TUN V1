    local weak={role="FRONT",attack=10,cost=20,readyAt=0,intercepts=false}
    local rear={role="REAR",attack=100,cost=100,readyAt=0,intercepts=true}
    return {strongFrontFirst=pickCombatUpgrade({weak,rear,front},600,1,false)==front,
        reachableRearInDanger=pickCombatUpgrade({front,rear},600,1,true)==rear,
        noWasteBehindEnemy=pickCombatUpgrade({front},600,1,true)==nil}
