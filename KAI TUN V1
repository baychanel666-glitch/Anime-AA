local function reason(result)
    local text={}
    local function add(v,depth)
        if type(v)=="string" then text[#text+1]=v
        elseif type(v)=="table" and depth<2 then local n=0 for k,x in pairs(v) do n+=1 if n>12 then break end if type(k)=="string" then text[#text+1]=k end add(x,depth+1) end end
    end
    for i=1,result.n do add(result[i],0) end return string.lower(table.concat(text," "))
