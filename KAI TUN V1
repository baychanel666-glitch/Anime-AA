   local override=tonumber(environment.FyrelithRejoinPlaceId)
   if override and override>0 then return override end
   -- Return to Anime Adventures lobby, rather than a reserved battle place.
   if game.GameId==3183403065 then return 8304191830 end
   return game.PlaceId
  end
