local function vec(v) return {v.X,v.Y,v.Z} end
local function unvec(v) assert(type(v)=="table" and #v==3,"Invalid cached vector") return Vector3.new(v[1],v[2],v[3]) end
local function mapIdentity(lanes)
    local fields={tostring(game.PlaceId),tostring(game.PlaceVersion)}
    local cfg=workspace:FindFirstChild("_MAP_CONFIG")
    for _,name in {"Level","Map","Area"} do local v=cfg and cfg:FindFirstChild(name) if v and v:IsA("ValueBase") then fields[#fields+1]=name..":"..tostring(v.Value) end end
    local nodes={}
    for _,lane in lanes:GetChildren() do for _,v in lane:GetChildren() do if v:IsA("BasePart") then
        nodes[#nodes+1]=lane.Name..":"..v.Name..":"..string.format("%.3f,%.3f,%.3f",v.Position.X,v.Position.Y,v.Position.Z)
    end end end
    table.sort(nodes) for _,n in nodes do fields[#fields+1]=n end
    local signature=table.concat(fields,"|") local hash=0
    for i=1,#signature do hash=(hash*31+signature:byte(i))%2147483647 end
    return signature,"AASmartPlacement/maps/"..tostring(game.PlaceId).."_"..tostring(hash)..".json"
end
local function readMapCache(lanes)
    diskSignature,diskPath=mapIdentity(lanes)
    local embedded=E.AAEmbeddedMapCache and E.AAEmbeddedMapCache[diskSignature]
    local exists=type(isfile)=="function" and isfile(diskPath)
    if not embedded and not exists then S.mapCacheStatus="new scan" return nil end
    local ok,result=pcall(function()
        local saved=embedded or game:GetService("HttpService"):JSONDecode(readfile(diskPath))
        assert(saved.version==1 and saved.signature==diskSignature and #saved.paths<=16,"Map cache mismatch")
        local paths={}
        for _,p in saved.paths do
            local path={lane=p.lane,length=p.length,samples={},segments={},straightSegments={}}
            assert(#p.samples<=1800 and #p.segments<=1000,"Oversized cache")
            for _,q in p.samples do path.samples[#path.samples+1]={p=unvec(q.p),w=q.w,s=q.s} end
            for _,kind in {"segments","straightSegments"} do for _,seg in p[kind] do
                path[kind][#path[kind]+1]={a=unvec(seg.a),b=unvec(seg.b),start=seg.start,length=seg.length}
            end end
            paths[#paths+1]=path
        end
        diskGround={}
        for key,hit in pairs(saved.ground or {}) do
            if hit==false then diskGround[key]=false else diskGround[key]={Position=unvec(hit.p),Normal=unvec(hit.n)} end
        end
        assert(#paths>0,"Empty cache") return paths
    end)
    S.mapCacheStatus=ok and (embedded and "loaded from embedded map" or "loaded from disk") or "invalid cache; rescanning"
    S.mapCacheSource=ok and (embedded and "EMBEDDED" or "DISK") or "SCAN"
    if ok and S.prepareStoryMapKnowledge then
        pcall(function() S.prepareStoryMapKnowledge((require(R.src.Loader).LevelData or {}).map,diskPath) end)
    end
    return ok and result or nil
end
local function saveMapCache(paths,ground,force)
    if not diskPath or (not force and os.clock()-(lastDiskSave or 0)<(S.mobileMode and 30 or 15)) then return end
    if not force then
        local size=0 for _ in pairs(ground or {}) do size+=1 end
        if size==lastSavedGroundCount then return end
        lastSavedGroundCount=size
    end
    lastDiskSave=os.clock()
    local ok=pcall(function()
        if not isfolder("AASmartPlacement") then makefolder("AASmartPlacement") end
        if not isfolder("AASmartPlacement/maps") then makefolder("AASmartPlacement/maps") end
        local packed={version=1,signature=diskSignature,paths={},ground={}}
        for _,p in paths do
            local row={lane=p.lane,length=p.length,samples={},segments={},straightSegments={}}
            for _,q in p.samples do row.samples[#row.samples+1]={p=vec(q.p),w=q.w,s=q.s} end
            for _,kind in {"segments","straightSegments"} do for _,s in p[kind] do
                row[kind][#row[kind]+1]={a=vec(s.a),b=vec(s.b),start=s.start,length=s.length}
            end end
            packed.paths[#packed.paths+1]=row
        end
        local count=0 for key,hit in pairs(ground or {}) do
            count+=1 if count>(S.mobileMode and 1200 or 4000) then break end
            if hit==false then packed.ground[key]=false else packed.ground[key]={p=vec(hit.Position),n=vec(hit.Normal)} end
        end
        writefile(diskPath,game:GetService("HttpService"):JSONEncode(packed))
    end)
    S.mapCacheSaved=ok S.mapCacheFile=diskPath
    if ok and S.prepareStoryMapKnowledge then
        pcall(function()
            local ld=require(R.src.Loader).LevelData or {}
            S.prepareStoryMapKnowledge(ld.map,diskPath)
        end)
    end
end

