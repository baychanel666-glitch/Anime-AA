function S.close(forReplacement)
    local errors={}
    local function cleanup(label,fn)
        local ok,err=pcall(fn)
        if not ok then errors[#errors+1]=label..": "..tostring(err) end
    end
    -- Stop decision loops before cache writes or UI restoration can fail.
    S.autorun=false S.enabled=false S.alive=false S.generation+=1
    E.AAStarterSummonBusy=false E.AAStarterSetupActive=false
    if forReplacement~=true then
        local dex=E.AASummonDex
        if dex and dex.alive and type(dex.close)=="function" then
            local ok,err=pcall(dex.close)
            if not ok then E.AALinkedCloseError=tostring(err) errors[#errors+1]=tostring(err) end
        end
    end
    if pathCache then cleanup("map cache",function() saveMapCache(pathCache,groundCache,true) end) end
    cleanup("native skip",function()
        if S.nativeSkipSetting and S.nativeSkipSetting.Parent then S.nativeSkipSetting.Value=S.nativeSkipOriginal end
    end)
    if S.saveSettings then cleanup("settings",function() assert(S.saveSettings(false)~=false,"Settings save rejected") end) end
    cleanup("other automation",restoreOtherAutomation)
    if marker then cleanup("marker",function() marker:Destroy() end) end
    for _,restore in S.restorers do cleanup("restorer",restore) end
    for _,c in S.connections do cleanup("connection",function() c:Disconnect() end) end
    for _,h in S.headers do cleanup("header",function() h:Destroy() end) end
    for _,o in S.overlays do cleanup("overlay",function() o:Destroy() end) end
    cleanup("main UI",function() gui:Destroy() end)
    E.AAMainCloseErrors=errors
end
