modules.equip=assert(loadstring([================[-- F02: incremental replacement for the old blocking equipInventoryTeam loop.
-- DI: read() -> {profile=..., slots={"1", ...}}, send(uuid, slot), matches(profile,plan), clock().
-- One unresolved native request at a time. A timeout is not proof of rejection.
return function(deps)
    assert(type(deps) == "table" and type(deps.read) == "function"
        and type(deps.send) == "function" and type(deps.matches) == "function"
        and type(deps.clock) == "function", "Missing equip dependencies")
    local self = {enabled = true, busy = false, generation = 0, pending = nil, retryAt = 0, attempts = {}}

    local function validPlan(plan, profile, capacity)
        if type(plan) ~= "table" or type(plan.team) ~= "table" then return false end
        local count, seen = 0, {}
        for index, row in pairs(plan.team) do
            if type(index) ~= "number" or index < 1 or index % 1 ~= 0
                or type(row) ~= "table" or type(row.uuid) ~= "string" or row.uuid == ""
                or seen[row.uuid] or type(profile.owned_units[row.uuid]) ~= "table" then return false end
            count += 1 seen[row.uuid] = true
        end
        if count == 0 or count > capacity then return false end
        for index = 1, count do if plan.team[index] == nil then return false end end
        return true, seen
    end

    function self.stop()
        self.enabled = false self.generation += 1
        -- Retain an unresolved request across stop/start: never resend it blindly.
    end
    function self.start() self.enabled = true end
    function self.tick(plan)
        if not self.enabled then return false, "STOPPED" end
        if self.busy then return false, "BUSY" end
        self.busy = true
        local ok, done, reason = pcall(function()
            local snapshot = deps.read()
            local profile = snapshot and snapshot.profile
            local slots = snapshot and snapshot.slots
            if type(profile) ~= "table" or type(profile.owned_units) ~= "table"
                or type(profile.equipped_units) ~= "table" or type(slots) ~= "table" or #slots == 0 then
                return false, "WAITING_FOR_PROFILE"
            end
            if self.pending then
                local equipped = false
                for _, uuid in pairs(profile.equipped_units) do
                    if uuid == self.pending.uuid then equipped = true break end
                end
                if equipped then self.attempts[self.pending.uuid] = nil self.pending = nil
                elseif type(profile.owned_units[self.pending.uuid]) ~= "table" then
                    self.pending = nil return false, "PENDING_UNIT_REMOVED"
                else
                    local age=deps.clock()-self.pending.started
                    local attempts=self.attempts[self.pending.uuid] or self.pending.attempt or 1
                    -- Opt-in only for the free, idempotent Equip endpoint; never purchases.
                    if type(deps.idempotentRetryAfter)=="number" and not self.pending.error
                        and age>=deps.idempotentRetryAfter and attempts<(deps.maxAttempts or 2) then
                        self.attempts[self.pending.uuid]=attempts
                        self.pending=nil
                    else
                        return false, age>=2 and "WAITING_FOR_REPLICATION" or "PENDING"
                    end
                end
            end
            local valid, wanted = validPlan(plan, profile, #slots)
            if not valid then return false, "INVALID_OR_STALE_PLAN" end
            if deps.matches(profile, plan) then return true, "CONFIRMED" end
            if deps.clock() < self.retryAt then return false, "RETRY_BACKOFF" end
            local current = {}
            for _, uuid in pairs(profile.equipped_units) do current[uuid] = true end
            local uuid
            for _, row in ipairs(plan.team) do if not current[row.uuid] then uuid = row.uuid break end end
            local slot, replaceSlot
            for _, allowed in ipairs(slots) do
                if profile.equipped_units[allowed] == nil then slot = allowed break end
                if not wanted[profile.equipped_units[allowed]] and not replaceSlot then replaceSlot = allowed end
            end
            slot = slot or replaceSlot
            if not uuid or not slot then return false, "NO_AVAILABLE_SLOT" end
            local generation = self.generation
            self.attempts[uuid]=(self.attempts[uuid] or 0)+1
            self.pending = {uuid = uuid, slot = slot, started = deps.clock(), generation = generation,attempt=self.attempts[uuid]}
            self.retryAt=deps.clock()+math.max(0,tonumber(deps.minimumInterval) or 0)
            local sent, reply = pcall(deps.send, uuid, slot)
            if sent and reply == false then self.pending = nil self.retryAt = math.max(self.retryAt,deps.clock() + 1) end
            if not self.enabled or generation ~= self.generation then return false, "STOPPED_DURING_REQUEST" end
            if not sent then
                self.pending.error = tostring(reply)
                return false, "REQUEST_OUTCOME_UNKNOWN"
            end
            if reply == false then
                return false, "SERVER_REJECTED"
            end
            -- Success reply still needs authoritative snapshot confirmation on the next tick.
            return false, "REQUEST_SENT"
        end)
        self.busy = false
        if not ok then self.lastError = tostring(done) return false, "ADAPTER_ERROR" end
        self.lastError = nil self.status = reason
        return done, reason
    end
    return self
end
