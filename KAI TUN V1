local upgradeRemote=R.endpoints.client_to_server:FindFirstChild("upgrade_unit_ingame")
local function roleFor(u,pathList)
    if isFarm(u) then return "FARM" end
    local saved=S.placementRoles[u.unit]
    if saved then return saved end
    local nearest,bestProgress,bestDistance
    for _,path in pathList do
        local p,d=project(u.p,path)
        if not bestDistance or d<bestDistance then nearest=path bestProgress=p bestDistance=d end
    end
    local range=tonumber(val(u.stats,"range")) or 6
    local role=nearest and bestProgress>frontEnd(nearest,range)+2 and "REAR" or "FRONT"
    S.placementRoles[u.unit]=role
    return role
end
S.upgradePending=setmetatable({},{__mode="k"})
function S.reconcileHeroUpgrade(u)
    local pending=S.upgradePending[u.unit]
    if not pending then return false end
    if (tonumber(val(u.stats,"upgrade")) or pending.before)>pending.before then
        S.upgradePending[u.unit]=nil
        S.upgradeCooldown[u.unit]=os.clock()+0.35
        S.upgraded+=1 pending.confirmed=true pending.totalMs=(os.clock()-pending.started)*1000
        S.lastUpgrade=pending
        S.recordConfirmedAction("UPGRADE",pending.name,{from=pending.before,cost=pending.cost,priority=pending.role})
        return false
    end
    if os.clock()-pending.started>=3 then
        if not pending.charged then
            S.upgradePending[u.unit]=nil S.upgradeCooldown[u.unit]=os.clock()+0.75
            pending.error="No upgrade/debit confirmation; retry after cooldown"
        else pending.error="Debit observed; waiting for level confirmation without resending" end
        S.lastUpgrade=pending
    end
    return S.upgradePending[u.unit]~=nil
end
local function upgradeCandidates(farmOnly)
    local choices={} local ps
    for _,u in ownUnits() do
        if S.reconcileHeroUpgrade(u) then continue end
        local n=val(u.stats,"upgrade") local max=val(u.stats,"max_upgrade") local d=defs[val(u.stats,"id")]
        local next=n and d and d.upgrade and d.upgrade[n+1]
        local cost=next and tonumber(next.cost)
        local health=tonumber(val(u.stats,"health"))
        if cost and max and n<max and (not health or health>0) and (not farmOnly or isFarm(u) and (not S.speedwagonEquipped or val(u.stats,"id")=="speedwagon")) then
            if not farmOnly and not ps then ps=paths() end
            cost=math.ceil(cost*(tonumber(val(u.stats,"upgrade_cost_multiplier")) or 1))
            local attack=tonumber(val(u.stats,"damage")) or d.damage or 0
            local interval=math.max(tonumber(val(u.stats,"attack_cooldown")) or d.attack_cooldown or 1,0.1)
            local radius=tonumber(val(u.stats,"range")) or d.range or 0
            local oldStage=n>0 and d.upgrade[n] or d
            local attackScale=(oldStage.damage or 0)>0 and attack/oldStage.damage or 1
            local nextAttack=(next.damage or oldStage.damage or 0)*attackScale
            local intervalScale=(oldStage.attack_cooldown or 0)>0 and interval/oldStage.attack_cooldown or 1
            local nextInterval=math.max((next.attack_cooldown or oldStage.attack_cooldown or 1)*intervalScale,0.1)
            local nextRange=next.range or radius
            local gain=math.max(0,nextAttack/nextInterval-attack/interval)
            gain+=attack/interval*math.max(0,nextRange-radius)/math.max(radius,1)*0.4
            if S.isDevelopmentFarm(d) then gain=math.max(0,(next.farm_amount or d.farm_amount)-(oldStage.farm_amount or d.farm_amount)) end
            choices[#choices+1]={unit=u.unit,stats=u.stats,level=n,cost=cost,role=farmOnly and "FARM" or roleFor(u,ps),
                rank=S.placementTeamRanks and S.placementTeamRanks[val(u.stats,"uuid")],
                attack=attack,nextAttack=nextAttack,nextInterval=nextInterval,position=u.p,nextRange=nextRange,value=gain/math.max(cost,1),readyAt=S.upgradeCooldown[u.unit] or 0}
        end
    end
    return choices
end
local function pickUpgrade(choices,budget,now)
    local hasRear=false
    for _,c in choices do if c.role=="REAR" then hasRear=true break end end
    local selected
    for _,c in choices do
        if (not hasRear or c.role=="REAR") and c.cost<=budget and now>=(c.readyAt or 0) then
            if not selected or (S.valueUpgrades and (c.value or 0)>(selected.value or 0))
                or ((not S.valueUpgrades or (c.value or 0)==(selected.value or 0)) and c.cost<selected.cost) then selected=c end
        end
    end
    return selected,hasRear and "REAR" or "FRONT"
end
function S.pickFarmIncomeUpgrade(choices,budget,now)
    local best
    for _,candidate in choices do
        if candidate.cost<=budget and now>=(candidate.readyAt or 0)
            and (not best or candidate.value>best.value or candidate.value==best.value and candidate.cost<best.cost) then best=candidate end
    end
    return best
end
local function pickFinalUpgrade(choices,budget,now)
    local best
    for _,c in choices do
        if c.cost<=budget and (not best or c.attack>best.attack or (c.attack==best.attack and c.cost<best.cost)) then best=c end
    end
    -- Wait for the strongest affordable unit's request cooldown instead of spending on a weaker unit.
    if best and now>=(best.readyAt or 0) then return best end
end
local function pickCombatUpgrade(choices,budget,now,danger)
    local pool={}
    local front=false
    for _,c in choices do if c.role=="FRONT" then front=true end end
    for _,c in choices do
        if (danger and c.intercepts) or (not danger and (not front or c.role=="FRONT")) then pool[#pool+1]=c end
    end
    return pickFinalUpgrade(pool,budget,now)
end
S.testPerformanceGeometry=function()
