    function S.claimStarterStory()
        local ss=session() if not ss then return false end
        S.pauseStarterNavigation()
        local world=require(R.src.Data.Worlds)[state.firstWorld or "namek"]
        local levels=require(R.src.Data.Levels)
        local completed=ss.profile_data.level_data.completed_story_levels
        if completedCount(state.firstStage or "namek_level_6")<=0 then
            S.starterSummonStatus="Story completion not recorded by game; summons and next world remain LOCKED"
            return false
        end
        state.claimAttempts=state.claimAttempts or {}
        for _,row in pairs(world.levels) do
            local def=levels[row.id] local progress=completed[row.id]
            for difficulty,rewards in pairs(def and def.clear_rewards or {}) do
                local done=progress and progress.difficulty_completed_data and progress.difficulty_completed_data[difficulty]
                local clears=done and tonumber(done.times_completed) or 0
                for _,reward in pairs(rewards) do
                    local claimed=ss.profile_data.clear_rewards and ss.profile_data.clear_rewards[row.id]
                    claimed=claimed and claimed[difficulty] and claimed[difficulty][reward._id]
                    local key=row.id..":"..difficulty..":"..tostring(reward._id)
                    if not claimed and clears>=(tonumber(reward.clears) or math.huge) then
                        if os.time()-(state.claimAttempts[key] or 0)>=8 then
                            state.claimAttempts[key]=os.time() saveStarter()
                            invoke("claim_first_clear_rewards",row.id,difficulty,reward._id)
                        end
                        S.starterSummonStatus="Claiming Story clear rewards; waiting for server confirmation"
                        return false
