    end
    -- Scheduled returns apply to Infinite, Story and World Skip alike.
    if not due and not S.hourlyReturnPending then return end
    if not S.hourlyReturnPending then
        -- Persist before sending: an intentional exit is never a local World defeat.
        local row=hourlyClock.consume(state,os.time(),game.JobId,(Loader.LevelData or {}).id)
        S.saveHourlySummon(row)
        S.hourlyReturnPending=true S.summonReturnPending=false
        S.hourlyReturnReason="HOURLY_SUMMON_EST"
    end
    if os.clock()<(S.hourlyReturnRetryAt or 0) then return end
    S.hourlyReturnRetryAt=os.clock()+8
