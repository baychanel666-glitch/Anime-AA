    state.active=state.phase~="IDLE" and state.phase~="DONE"
    state.done=state.phase=="DONE"
    if state.phase=="SECOND_RUN" and state.round==2 and state.lastEvent=="GEMS_EXHAUSTED" then
        state.secondSummonFinished=true state.phase="REBUILD_TEAM"
    end
    if state.phase=="FIRST_RUN" and state.firstStage and state.firstCompletedBefore==nil then state.firstCompletedBefore=0 end
    S.starterSummon=state
    E.AAStarterSetupActive=state.active
    E.AAStarterSummonBusy=state.active and (state.phase=="INITIAL_SUMMON" or state.phase=="FIRST_REWARDS" or state.phase=="CLAIM_STORY" or state.phase=="SECOND_SUMMON" or state.phase=="REBUILD_TEAM")
    S.starterSummonBlocking=Loader.IsLobby and E.AAStarterSummonBusy
    S.starterEligibilityResolved=not Loader.IsLobby or state.active or state.done
    local emptySamples=0 local startedAt=os.clock()
    local function saveStarter()
        if not isfolder("AASmartPlacement") then makefolder("AASmartPlacement") end
