        for k,v in pairs(claimed) do if k==code and v or v==code then owned=true break end end
        local log=S.codeRedeemLog[code] or {}
        if owned then log.confirmed=true S.codeRedeemLog[code]=log
        elseif not log.confirmed and not log.terminal and os.time()>=(log.nextTry or 0) then
            S.codeRedeemBusy=true
            local ok,reply=pcall(invoke,"redeem_code",code)
            local deadline=os.clock()+1
